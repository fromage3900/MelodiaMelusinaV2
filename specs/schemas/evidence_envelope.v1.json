{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodia.local/schemas/evidence_envelope.v1.json",
  "title": "Melodia Evidence Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidence_id", "run_id", "kind", "status", "recorded_at_utc", "repository", "producer", "checks", "artifacts"],
  "properties": {
    "schema": {"const": "melodia.evidence_envelope.v1"},
    "evidence_id": {"type": "string", "minLength": 8},
    "run_id": {"type": "string", "minLength": 8},
    "kind": {"enum": ["gate", "static", "runtime", "t3d_mutation", "build", "package", "model"]},
    "status": {"enum": ["pass", "fail", "hold"]},
    "gate_id": {"type": "string", "minLength": 1},
    "recorded_at_utc": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "commit", "branch"],
      "properties": {
        "root": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 7},
        "branch": {"type": "string", "minLength": 1}
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "version"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "subject": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "hold"]},
          "note": {"type": "string"}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
          "role": {"type": "string"}
        }
      }
    },
    "notes": {"type": "string"}
  }
}
