{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Melodia Resonant World Magic Passage Portfolio v1",
  "type": "object",
  "required": ["format", "schema_version", "passage_version", "world_seed", "passage_count", "passages"],
  "properties": {
    "format": {"const": "melodia_resonant_world_magic_passage_portfolio"},
    "schema_version": {"const": 1},
    "passage_version": {"const": "resonant_magic_passage_v1"},
    "world_seed": {"type": "integer"},
    "atlas_summary": {"type": "object"},
    "passage_count": {"type": "integer", "const": 6},
    "passages": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "resonant_world_magic_passage.v1.json"}
    },
    "validation_errors": {"type": "array", "items": {"type": "string"}},
    "ok": {"const": true}
  },
  "additionalProperties": true
}
