{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Melodia Houdini Foundry bake request v1",
  "description": "Minimal input for the future TOP_Foundry_BakeFarm: an ordered list of recipes, optionally bound to one Universe Foundry mission task. The BakeFarm executes recipes; it does not invent them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "request_id",
    "recipes"
  ],
  "properties": {
    "schema": {
      "const": "melodia.houdini_foundry_bake_request.v1"
    },
    "request_id": {
      "type": "string"
    },
    "mission_ref": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "mission_id",
        "task_id"
      ],
      "properties": {
        "mission_id": {
          "type": "string"
        },
        "task_id": {
          "type": "string"
        }
      }
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "repo-relative recipe path"
      }
    },
    "stop_on_fail": {
      "type": "boolean",
      "default": true
    },
    "note": {
      "type": "string"
    }
  }
}
