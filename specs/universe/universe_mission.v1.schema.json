{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Melodia Universe Mission v1",
  "type": "object",
  "required": [
    "schema",
    "mission_id",
    "world_id",
    "genome_hash",
    "delta_hash",
    "authority",
    "tasks"
  ],
  "properties": {
    "schema": {
      "const": "melodia.universe_mission/v1"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "world_id": {
      "type": "string",
      "minLength": 1
    },
    "genome_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "delta_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authority": {
      "type": "object"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "phase",
          "owner",
          "depends_on",
          "mutation_surface",
          "done_when",
          "evidence_required"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mutation_surface": {
            "type": "string"
          },
          "command": {
            "type": [
              "string",
              "null"
            ]
          },
          "jev_decision": {
            "type": [
              "object",
              "null"
            ]
          },
          "done_when": {
            "type": "string"
          },
          "evidence_required": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
