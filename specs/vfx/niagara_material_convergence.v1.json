    "two_sided": true,
    "expression_count": 38,
    "parameter_count": 17,
    "usage_niagara_sprites": true,
    "usage_niagara_meshes": false,
    "usage_niagara_ribbons": false
  },
  "constraint_note": "UE material blend mode, shading model, and material domain are compile-time properties of the Material asset, not instance parameters. A single Material cannot be both translucent and masked, or unlit and default-lit. Therefore 'truly universal' is achieved by ONE master per (blend, shading) combo, sharing the same expression graph and parameter philosophy. The flipbook master is the translucent-unlit base; a masked-lit variant is needed for petals/cards that require solid depth.",
  "universal_masters": [
    {
      "name": "M_VFX_Universal_Translucent",
      "path": "/Game/Melodia/_PROJECT/VFX/Materials/M_VFX_Universal_Translucent",
      "base": "M_Niagara_MelodiaFlipbook",
      "blend_mode": "BLEND_Translucent",
      "shading_model": "MSM_Unlit",
      "two_sided": true,
      "covers": [
        "mist sheets", "sparkle", "glitter", "motes", "dust", "ribbons", "trails",
        "sigils", "globules", "impact bursts", "pollen", "wind fronts", "flipbooks",
        "gouache pool swirl", "star sparkle", "arc", "superposition", "eye sparkle",
        "cosmic portal (SDF composite)", "glitter sparkle (SDF composite)", "magic rune (SDF composite)",
        "musical notation (SDF composite)", "orrery rings (SDF composite)", "harmonic iris (SDF composite)"
      ],
      "excluded": [
        "SDF raymarched effects as primary shape (use SDF_CompositeMode=1 or separate SDF masters)",
        "masked/lit petals and cards (use M_VFX_Universal_Masked)",
        "solid opaque surfaces (not VFX)"
      ]
    },
    {
      "name": "M_VFX_Universal_Masked",
      "path": "/Game/Melodia/_PROJECT/VFX/Materials/M_VFX_Universal_Masked",
      "base": "M_Niagara_Morning_PetalCard",
      "blend_mode": "BLEND_Masked",
      "shading_model": "MSM_DefaultLit",
      "two_sided": true,
      "covers": [
        "petal cards", "petal meshes", "petal sprites (solid)", "cherry rosette",
        "note cards", "ornament cards", "any effect needing depth/occlusion"
      ],
      "excluded": [
        "translucent effects (use M_VFX_Universal_Translucent)",
        "SDF raymarched effects"
      ]
    }
  ],
  "sdf_masters": {
