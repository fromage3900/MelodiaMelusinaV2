  "variance": {
    "_rules": [
      "Scalar names containing the substring match case-insensitively; first matching rule wins; remaining entries are skipped.",
      "Multipliers apply to the parent's default value when the instance has no override (read default via MaterialEditingLibrary), never to an existing authored override.",
      "Vector rules set palette colors with optional per-instance hue jitter (seeded, within +/- 4%) so siblings vary without breaking family identity.",
      "Emission/Glow intensity rules only apply when the parent exposes an emission-ish parameter (substring match); they scale with a small per-instance factor 0.8-1.25.",
      "Switches flip static bool parameters (e.g. bShadowDream_Active) only when the parent gates them."
    ],
    "scalars": [
      { "match": "shadowdreamstrength", "mode": "set_override", "value": 0.3, "note": "Every instance gets the shadow-dream tint strength (pink/blue dream shadows)." },
      { "match": "shadowsoftness", "mode": "set_override", "value": 1.2, "note": "Soft shadow falloff." },
      { "match": "rampposmid", "mode": "set_override", "value": 0.5, "note": "Centered toon ramp." },
      { "match": "layerrampposmid", "mode": "set_override", "value": 0.5 },
      { "match": "rampstrength", "mode": "set_override", "value": 0.28, "note": "Toon ramp visible but tasteful." },
      { "match": "layerrampstrength", "mode": "set_override", "value": 0.22 },
      { "match": "tiling", "mode": "multiply_default", "factor_range": [1.0, 1.8], "note": "Tasteful tiling variance so swatches read differently." },
      { "match": "roughness", "mode": "multiply_default", "factor_range": [0.9, 1.25], "note": "Satin/velvet roughness band, Nikki-restrained." },
      { "match": "gloss", "mode": "multiply_default", "factor_range": [0.9, 1.15], "note": "Subtle sheen lift." },
      { "match": "emissive_intensity", "mode": "multiply_default", "factor_range": [0.85, 1.3], "note": "Soft dream glow." },
      { "match": "emission_intensity", "mode": "multiply_default", "factor_range": [0.85, 1.3] },
      { "match": "glow", "mode": "multiply_default", "factor_range": [0.9, 1.35], "note": "Whimsical glow accents." },
      { "match": "opacity", "mode": "multiply_default", "factor_range": [0.85, 1.0], "note": "Never above default; translucency stays subtle." },
      { "match": "metallic", "mode": "set_override", "value": 0.0, "note": "Enforce non-metallic dream look on toon materials." },
      { "match": "ao_strength", "mode": "multiply_default", "factor_range": [0.9, 1.1] },
      { "match": "normal_strength", "mode": "multiply_default", "factor_range": [0.85, 1.15] },
      { "match": "displacement", "mode": "multiply_default", "factor_range": [0.9, 1.1], "note": "Parallax stays gentle." }
    ],
    "vectors": [
      { "match": "shadowdreamtint", "palette": "melodia_shadowdream_pinkblue", "jitter": 0.03, "note": "Pink/blue dream shadows." },
      { "match": "ramplow", "palette": "melodia_shadowdream_pinkblue", "jitter": 0.03, "note": "Toon ramp low stop (dream pink)." },
      { "match": "rampmid", "palette": "melodia_shadowdream_pinkblue", "jitter": 0.03, "note": "Toon ramp mid stop (lavender pink)." },
      { "match": "ramphigh", "palette": "melodia_shadowdream_pinkblue", "jitter": 0.02, "note": "Toon ramp high stop (sky blue)." },
      { "match": "base_color", "palette": "nikki_pastel", "jitter": 0.04 },
      { "match": "basecolor", "palette": "nikki_pastel", "jitter": 0.04 },
      { "match": "albedo", "palette": "nikki_pastel", "jitter": 0.04 },
      { "match": "tint", "palette": "melodia_dream", "jitter": 0.03 },
      { "match": "dreamtint", "palette": "melodia_dream", "jitter": 0.03 },
      { "match": "emissive", "palette": "crystal_glow", "jitter": 0.03 },
      { "match": "emission_color", "palette": "crystal_glow", "jitter": 0.03 },
      { "match": "glow_color", "palette": "crystal_glow", "jitter": 0.03 },
      { "match": "iridescence", "palette": "melodia_iris", "jitter": 0.02 },
      { "match": "rim_color", "palette": "melodia_iris", "jitter": 0.03 },
      { "match": "subsurface", "palette": "nikki_pastel", "jitter": 0.04 }
    ],
    "switches": [
      { "match": "bshadowdream_active", "value": true, "note": "Flip the gated ShadowDream family on where the parent exposes it (Nikki masters)." }
    ]
  },
  "family_policies": {
    "_families": {
      "SDF":    { "scalars": ["tiling", "roughness", "emissive_intensity", "emission_intensity", "glow", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color", "emissive", "glow_color", "rim_color", "iridescence"], "palette_bias": "dream_iridescent" },
      "Baroque": { "scalars": ["tiling", "roughness", "gloss", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color", "tint", "gold"], "palette_bias": "nikki_pastel" },
      "Crystal": { "scalars": ["tiling", "roughness", "emission_intensity", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color", "emissive"], "palette_bias": "crystal_glow" },
      "Halftone": { "scalars": ["tiling", "roughness", "emissive_intensity", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color", "tint"], "palette_bias": "nikki_pastel" },
      "Glitter": { "scalars": ["tiling", "glow", "emission_intensity", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color", "iridescence", "glow_color"], "palette_bias": "dream_iridescent" },
      "Landscape": { "scalars": ["tiling", "shadowdreamstrength", "shadowsoftness", "rampstrength", "layerrampstrength", "rampposmid", "layerrampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color"], "palette_bias": "nikki_pastel" },
      "Water": { "scalars": ["tiling", "gloss", "opacity", "shadowdreamstrength", "shadowsoftness"], "vectors": ["shadowdreamtint", "base_color", "subsurface"], "palette_bias": "crystal_glow" },
      "Utility": { "scalars": ["tiling", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh"], "palette_bias": "nikki_pastel" },
      "Impressionist": { "scalars": ["tiling", "roughness", "shadowdreamstrength", "shadowsoftness", "rampstrength", "rampposmid"], "vectors": ["shadowdreamtint", "ramplow", "rampmid", "ramphigh", "base_color"], "palette_bias": "nikki_pastel" }
    },
    "notes": "Family selection is by asset-name prefix match (MI_<Family>_... or folder name); the applicator logs each family's matched-vs-skipped parameter names so the policy stays grounded in reality."
  }
