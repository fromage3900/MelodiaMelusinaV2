*.usd    filter=lfs diff=lfs merge=lfs -text lockable
*.usda   filter=lfs diff=lfs merge=lfs -text lockable
*.usdc   filter=lfs diff=lfs merge=lfs -text lockable
*.obj    filter=lfs diff=lfs merge=lfs -text lockable

