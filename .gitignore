!Content/TurnBasedJRPGTemplate/Blueprints/Battle/
Content/TurnBasedJRPGTemplate/Blueprints/Battle/*
!Content/TurnBasedJRPGTemplate/Blueprints/Battle/BP_BattleController.uasset

