// =====================================================================
// POITOU LANES - the village lane ribbons.
// ---------------------------------------------------------------------
// The village is organised on radial lanes running out from the church.
// Each lane is a 2.4 m ribbon (one bar of 4/4, the governing meter) of
// trodden limestone gravel, with a kerb course standing proud on each
// side.  The kerb is what makes a lane read as a lane.
//
// The lanes are generated, not placed: the radial pattern, the wiggle and
// the 12 m house spacing all come from the HDA's own parms, so the
// village can be re-tuned without re-authoring anything.
//
// Input 0: the layout points (so the lanes can dodge the houses)
// Input 1: the terrain
// =====================================================================

string MAT_LANE = chs("../lane_material");
string MAT_KERB = chs("../foundation_material");

int   LANES   = chi("../radial_lanes");
float SPACING = chf("../lane_spacing");
float LEN     = chf("../lane_length");
float WIDTH   = 2.4;                 // one bar of 4/4
float CHURCH_X = 520.0, CHURCH_Z = 580.0;
float WIGGLE  = 0.35;

int np = npoints(0);
for(int L=0; L<LANES; L++){
    float a = radians(float(L)*360.0/float(LANES) + 25.0);
    int segs = int(LEN/SPACING);
    for(int s=0;s<segs;s++){
        float d0 = float(s)*SPACING, d1 = float(s+1)*SPACING;
        float w0 = WIGGLE*sin(d0/35.0 + L);
        float w1 = WIGGLE*sin(d1/35.0 + L);
        vector p0 = set(CHURCH_X + d0*cos(a+w0), 0, CHURCH_Z + d0*sin(a+w0));
        vector p1 = set(CHURCH_X + d1*cos(a+w1), 0, CHURCH_Z + d1*sin(a+w1));
        // dodge the houses: a lane does not run through a house
        int blocked = 0;
        for(int i=0;i<np;i++){
            if(point(0,"type",i) != "building") continue;
            vector hp = point(0,"P",i);
            vector hs = point(0,"scale",i);
            if(distance(set(hp.x,0,hp.z), set(p0.x,0,p0.z)) < max(hs.x,hs.z)*0.6 + WIDTH*0.6) { blocked=1; break; }
            if(distance(set(hp.x,0,hp.z), set(p1.x,0,p1.z)) < max(hs.x,hs.z)*0.6 + WIDTH*0.6) { blocked=1; break; }
        }
        if(blocked) continue;
        p0.y = volumesample(1, "height", p0) + 0.06;
        p1.y = volumesample(1, "height", p1) + 0.06;
        kit_ribbon(p0, p1, WIDTH, 0.30, MAT_LANE, MAT_KERB,
                   0.35, 0.15, 0.25, 0.0, "lane");
    }
}
