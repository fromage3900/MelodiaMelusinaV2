// derived masks: flow (slope + canal proximity), debris (steep ruin/rise + noise), wetness (low ground near water)
float cdv=@cd; vector g=volumegradient(0,"height",@P); float slope=length(set(g.x,0,g.z));
float nz=fit(noise(@P*0.08+ch("../seed")),0.25,0.75,0,1);
@flow = clamp(slope*ch("../flow_slope_gain")*0.5 + 0.6*exp(-cdv/12.0), 0, 1);
@debris = clamp((slope*4.0)*(0.4+0.6*@ruin_rise) * (0.5+0.5*nz) + 0.3*@ruin_rise*nz, 0, 1);
@wetness = clamp(max(max(@water, exp(-cdv/6.0)), 1-(@height-ch("../marsh_base")+0.3)/0.9), 0, 1);
