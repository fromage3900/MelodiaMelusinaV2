{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://melodia.local/schemas/agent_task_packet.v1.json",
  "schema": "melodia.agent_task_packet/v1",
  "title": "Melodia Agent Task Packet v1",
  "description": "Canonical bounded work packet shared by Hermes, the jcode swarm, model_router and verification gates. A packet authorizes a task shape; it does not grant editor, git, Perforce, or publication authority by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "goal", "done_when", "mutation_scope", "budget_usd", "max_turns"],
  "properties": {
    "schema": {
      "const": "melodia.agent_task_packet/v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "lane": {
      "type": "string",
      "description": "Optional coordinator hint. model_router route is authoritative for the routed task class."
    },
    "inputs": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "surfaces": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "may_write": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "must_not": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "mutation_scope": {
      "type": "string",
      "enum": ["none", "files", "editor", "git"]
    },
    "done_when": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts_expected": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "worktree": {
      "type": ["string", "null"],
      "default": null
    },
    "budget_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000
    },
    "max_turns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "default": {}
    }
  }
}
