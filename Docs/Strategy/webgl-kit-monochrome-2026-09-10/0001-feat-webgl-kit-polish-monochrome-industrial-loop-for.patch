@@ -0,0 +1,97 @@
+import { chromium } from 'playwright';
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const OUT = path.join(__dirname, 'evidence');
+const BASE = 'http://127.0.0.1:8765/tools/fromage-webgl-kit/prototypes/procedural-industrial-loop/';
+
+fs.mkdirSync(OUT, { recursive: true });
+
+const browser = await chromium.launch({
+  executablePath: '/usr/local/bin/google-chrome',
+  headless: true,
+  args: ['--use-gl=angle', '--enable-webgl', '--ignore-gpu-blocklist'],
+});
+
+const page = await browser.newPage({ viewport: { width: 1440, height: 900 } });
+const errors = [];
+page.on('pageerror', (err) => errors.push(String(err)));
+page.on('console', (msg) => {
+  if (msg.type() === 'error' && !msg.text().includes('favicon')) errors.push(msg.text());
+});
+page.on('response', (res) => {
+  if (res.status() >= 400 && !res.url().includes('favicon')) {
+    errors.push(`${res.status()} ${res.url()}`);
+  }
+});
+
+await page.goto(BASE, { waitUntil: 'networkidle' });
+await page.waitForFunction(() => window.__industrialLoop && document.querySelector('canvas'));
+await page.waitForTimeout(800);
+
+const diagDesktop = await page.evaluate(() => window.__industrialLoop.getDiagnostics());
+
+for (const t of [0, 2, 4, 6, 8, 10, 12, 14]) {
+  await page.evaluate((time) => window.__industrialLoop.setTime(time), t);
+  await page.waitForTimeout(120);
+  await page.locator('#stage').screenshot({ path: path.join(OUT, `base_t${String(t).padStart(2, '0')}.png`) });
+}
+
+for (const mode of ['base', 'structural', 'flow', 'thermal']) {
+  await page.evaluate((m) => {
+    window.__industrialLoop.setMode(m);
+    window.__industrialLoop.setTime(5.2);
+  }, mode);
+  await page.waitForTimeout(150);
+  await page.locator('#stage').screenshot({ path: path.join(OUT, `mode_${mode}.png`) });
+}
+
+for (const seed of [1, 2, 3]) {
+  await page.evaluate((s) => {
+    window.__industrialLoop.setMode('base');
+    window.__industrialLoop.setSeed(s);
+    window.__industrialLoop.setTime(3.0);
+  }, seed);
+  await page.waitForTimeout(180);
+  await page.locator('#stage').screenshot({ path: path.join(OUT, `seed_${String(seed).padStart(2, '0')}.png`) });
+}
+
+const capturePage = await browser.newPage({ viewport: { width: 1920, height: 1080 } });
+await capturePage.goto(`${BASE}?capture=1`, { waitUntil: 'networkidle' });
+await capturePage.waitForFunction(() => window.__industrialLoop && document.querySelector('canvas'));
+await capturePage.evaluate(() => {
+  window.__industrialLoop.setMode('base');
+  window.__industrialLoop.setSeed(1);
+  window.__industrialLoop.setTime(4.0);
+  window.__industrialLoop.pause();
+});
+await capturePage.waitForTimeout(300);
+await capturePage.screenshot({ path: path.join(OUT, 'capture_hero.png') });
+
+await capturePage.evaluate(() => window.__industrialLoop.play());
+for (let i = 0; i < 8; i += 1) {
+  await capturePage.waitForTimeout(500);
+  await capturePage.screenshot({ path: path.join(OUT, `loop_frame_${String(i).padStart(2, '0')}.png`) });
+}
+
+const mobile = await browser.newPage({ viewport: { width: 390, height: 844 } });
+await mobile.goto(BASE, { waitUntil: 'networkidle' });
+await mobile.waitForFunction(() => window.__industrialLoop && document.querySelector('canvas'));
+await mobile.waitForTimeout(600);
+const diagMobile = await mobile.evaluate(() => window.__industrialLoop.getDiagnostics());
+await mobile.screenshot({ path: path.join(OUT, 'mobile_width.png'), fullPage: true });
+
+const report = {
+  checked_at: new Date().toISOString(),
+  console_errors: errors,
+  desktop: diagDesktop,
+  mobile: diagMobile,
+  files: fs.readdirSync(OUT).filter((f) => f.endsWith('.png')),
+};
+fs.writeFileSync(path.join(OUT, 'runtime_report.json'), JSON.stringify(report, null, 2));
+console.log(JSON.stringify(report, null, 2));
+
+await browser.close();
+if (errors.length) process.exit(2);
