index 0000000..6f3dd55
--- /dev/null
+++ b/tools/fromage-webgl-kit/prototypes/procedural-industrial-loop/capture_evidence.mjs
@@ -0,0 +1,143 @@
+import { chromium } from 'playwright';
+import fs from 'fs';
+import path from 'path';
+import { fileURLToPath } from 'url';
+
+const __dirname = path.dirname(fileURLToPath(import.meta.url));
+const OUT = path.join(__dirname, 'evidence');
+const BASE = 'http://127.0.0.1:8765/tools/fromage-webgl-kit/prototypes/procedural-industrial-loop/';
+
+fs.mkdirSync(OUT, { recursive: true });
+
+function wait(ms) {
+  return new Promise((resolve) => setTimeout(resolve, ms));
+}
+
+const browser = await chromium.launch({
+  executablePath: '/usr/local/bin/google-chrome',
+  headless: true,
+  args: ['--use-gl=angle', '--enable-webgl', '--ignore-gpu-blocklist'],
+});
+
+const errors = [];
+
+async function openPage(url, viewport = { width: 1440, height: 900 }, recordVideo = false) {
+  const context = await browser.newContext({
+    viewport,
+    recordVideo: recordVideo
+      ? { dir: OUT, size: { width: viewport.width, height: viewport.height } }
+      : undefined,
+  });
+  const page = await context.newPage();
+  page.on('pageerror', (err) => errors.push(String(err)));
+  page.on('console', (msg) => {
+    if (msg.type() === 'error' && !msg.text().includes('favicon')) errors.push(msg.text());
+  });
+  page.on('response', (res) => {
+    if (res.status() >= 400 && !res.url().includes('favicon')) {
+      errors.push(`${res.status()} ${res.url()}`);
+    }
+  });
+  await page.goto(url, { waitUntil: 'networkidle' });
+  await page.waitForFunction(() => window.__industrialLoop && document.querySelector('canvas'));
+  await wait(700);
+  return { context, page };
+}
+
+// Interactive QA + draw-call sample
+const interactive = await openPage(BASE);
+const diagInteractive = await interactive.page.evaluate(() => {
+  window.__industrialLoop.setSeed(1);
+  window.__industrialLoop.setMode('base');
+  window.__industrialLoop.setTime(4);
+  return window.__industrialLoop.getDiagnostics();
+});
+await interactive.page.locator('#stage').screenshot({ path: path.join(OUT, 'industrial_base_hero.png') });
+
+// Deterministic capture URL stills
+const captureSpecs = [
+  { file: 'industrial_base_hero_url.png', url: '?capture=1&seed=1&mode=base&t=4' },
+  { file: 'industrial_structural.png', url: '?capture=1&seed=1&mode=structural&t=5.2' },
+  { file: 'industrial_flow.png', url: '?capture=1&seed=1&mode=flow&t=5.2' },
+  { file: 'industrial_thermal.png', url: '?capture=1&seed=1&mode=thermal&t=5.2' },
+];
+
+const captureDiags = {};
+for (const spec of captureSpecs) {
+  const { context, page } = await openPage(`${BASE}${spec.url}`, { width: 1920, height: 1080 });
+  await wait(400);
+  captureDiags[spec.file] = await page.evaluate(() => window.__industrialLoop.getDiagnostics());
+  await page.screenshot({ path: path.join(OUT, spec.file) });
+  await context.close();
+}
+
+// Seed variation 3-up via interactive
+for (const seed of [1, 2, 3]) {
+  await interactive.page.evaluate((s) => {
+    window.__industrialLoop.setMode('base');
+    window.__industrialLoop.setSeed(s);
+    window.__industrialLoop.setTime(3.0);
+  }, seed);
+  await wait(200);
+  await interactive.page.locator('#stage').screenshot({
+    path: path.join(OUT, `industrial_seed_${String(seed).padStart(2, '0')}.png`),
+  });
+}
+
+// Mobile width
+const mobile = await openPage(BASE, { width: 390, height: 844 });
+await wait(500);
+const diagMobile = await mobile.page.evaluate(() => window.__industrialLoop.getDiagnostics());
+await mobile.page.screenshot({ path: path.join(OUT, 'mobile_width.png'), fullPage: true });
+await mobile.context.close();
+
+// Loop endpoint check
+const loopCheck = await interactive.page.evaluate(() => {
+  window.__industrialLoop.setSeed(1);
+  window.__industrialLoop.setMode('base');
+  window.__industrialLoop.setTime(0);
+  const a = window.__industrialLoop.getDiagnostics();
+  window.__industrialLoop.setTime(16);
+  const b = window.__industrialLoop.getDiagnostics();
+  return { at0: a, at16: b };
+});
+
+await interactive.context.close();
+
+// Full 16s BASE capture video
+const videoSession = await openPage(
+  `${BASE}?capture=1&seed=1&mode=base&t=0`,
+  { width: 1920, height: 1080 },
+  true,
+);
+await videoSession.page.evaluate(() => {
+  window.__industrialLoop.setSeed(1);
+  window.__industrialLoop.setMode('base');
+  window.__industrialLoop.setTime(0);
+  window.__industrialLoop.play();
+});
+await wait(16200);
+await videoSession.page.evaluate(() => window.__industrialLoop.pause());
+const videoPath = await videoSession.page.video().path();
+await videoSession.context.close();
+
+const finalVideo = path.join(OUT, 'industrial_loop_base_16s.webm');
+if (videoPath && fs.existsSync(videoPath)) {
+  fs.renameSync(videoPath, finalVideo);
+}
+
+const report = {
+  checked_at: new Date().toISOString(),
+  console_errors: errors,
+  canonical_seed: 1,
+  interactive_base_t4: diagInteractive,
+  capture_url_diagnostics: captureDiags,
+  mobile: diagMobile,
+  loop_endpoint: loopCheck,
+  files: fs.readdirSync(OUT).sort(),
+};
+fs.writeFileSync(path.join(OUT, 'runtime_report.json'), JSON.stringify(report, null, 2));
+console.log(JSON.stringify(report, null, 2));
+
+await browser.close();
+if (errors.length) process.exit(2);
