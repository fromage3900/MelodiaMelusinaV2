        <type v="2048"/>
        <defaultValue><constantValueFloat4 v="0.9608 0.9255 0.8431 1"/></defaultValue>
        <defaultWidget>
          <name v="color"/>
          <options>
            <option><name v="default"/><value v="0.9608;0.9255;0.8431;1.0"/></option>
            <option><name v="min"/><value v="0"/></option>
            <option><name v="max"/><value v="1"/></option>
            <option><name v="clamp"/><value v="1"/></option>
