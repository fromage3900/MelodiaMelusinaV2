   Begin Object Name="MaterialExpressionComment_8" ExportPath="/Script/Engine.MaterialExpressionComment'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki.M_Master_Nikki:MaterialExpressionComment_8'"
      Text="MELODIA_COLUMN:05 | Triplanar\nWorld-aligned projection. bTriplanar_Active gates the lane (default OFF); slope mask + per-channel blend weights control how much world-space detail mixes with Layer A UVs."
      CommentColor=(R=0.060000,G=0.090000,B=0.140000,A=1.000000)
      MaterialExpressionEditorX=-2490
      MaterialExpressionEditorY=-840
      MaterialExpressionGuid=BB060AC34578278337ED6D9A536C99CC
