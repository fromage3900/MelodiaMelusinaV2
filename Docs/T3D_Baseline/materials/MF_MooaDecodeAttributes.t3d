   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Functions/MF_MooaDecodeAttributes.MF_MooaDecodeAttributes:MaterialExpressionCustom_2'"
      Code="#if POST_PROCESS_MATERIAL\r\n\tFToonGBufferData ToonGBuffer = GetScreenSpaceData(GetSceneTextureUV(Parameters) * float4(View.ResolutionFractionAndInv.xx, 1, 1)).GBuffer.MooaToonContext.ToonGBuffer;\r\n#else\r\n\tFToonGBufferData ToonGBuffer = DecodeToonGBufferDataFromMaterialAttribute(InMooaEncodedAttribute0, InMooaEncodedAttribute1, InMooaEncodedAttribute2, InMooaEncodedAttribute3, InMooaEncodedAttribute4);\r\n#endif\r\n\r\nShadingFeatureID = ToonGBuffer.ShadingFeatureID;\r\nMainLightShadowColor = ToonGBuffer.MainLightShadowColor;\r\nDiffuseColorRampIndex = ToonGBuffer.DiffuseColorRampIndex;\r\nDiffuseColorRampUVOffset = ToonGBuffer.DiffuseColorRampUVOffset;\r\nSpecularColor = ToonGBuffer.SpecularColor;\r\nSpecularColorRampIndex = ToonGBuffer.SpecularColorRampIndex;\r\nSpecularColorRampUVOffset = ToonGBuffer.SpecularColorRampUVOffset;\r\nReflectionIntensity = ToonGBuffer.ReflectionIntensity;\r\nRimLightIntensity = ToonGBuffer.RimLightIntensity;\r\nRimLightWidth = ToonGBuffer.RimLightWidth;\r\nFacialShadowSdfLeft = ToonGBuffer.FacialShadowSdfLeft;\r\nFacialShadowSdfRight = ToonGBuffer.FacialShadowSdfRight;\r\nStencil = ToonGBuffer.Stencil;\r\nRayTracingShadowFlag = ToonGBuffer.RayTracingShadowFlag;\r\n\r\nreturn 0;\r\n"
      Inputs(0)=(InputName="InMooaEncodedAttribute0",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaDecodeAttributes.MF_MooaDecodeAttributes:MaterialExpressionFunctionInput_4'"))
      Inputs(1)=(InputName="InMooaEncodedAttribute1",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaDecodeAttributes.MF_MooaDecodeAttributes:MaterialExpressionFunctionInput_1'"))
