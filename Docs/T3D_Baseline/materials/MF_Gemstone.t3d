      ExpressionCollection=(Expressions=("/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFunctionInput_2'","/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFunctionInput_3'","/Script/Engine.MaterialExpressionFunctionOutput'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFunctionOutput_2'","/Script/Engine.MaterialExpressionFunctionOutput'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFunctionOutput_3'","/Script/Engine.MaterialExpressionFresnel'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFresnel_3'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_5'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_6'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_7'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_8'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_9'","/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_1'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_10'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_11'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_12'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_13'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_14'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_15'","/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_2'","/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_3'","/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_4'","/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionCustom_0'"))
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionCustom_0'"
      Code="float edge = pow(saturate(EdgeMask), max(RefractionPower, 0.01));\nfloat rampMask = saturate((edge + Dispersion - 0.5) * max(RampContrast, 0.01) + 0.5);\nfloat midpoint = clamp(RampMidPoint, 0.001, 0.999);\nfloat3 ramp = lerp(RampLow, RampMid, smoothstep(0.0, midpoint, rampMask));\nramp = lerp(ramp, RampHigh, smoothstep(midpoint, 1.0, rampMask));\nfloat gemMask = saturate(GemstoneStrength) * edge;\nfloat nikkiMask = saturate(RampStrength) * edge;\nfloat iriMask = pow(edge, max(IridescencePower, 0.01)) * saturate(Iridescence);\nfloat3 gemColor = lerp(BaseColor, BaseColor * ramp, nikkiMask);\ngemColor = lerp(gemColor, ramp + GlowTint * saturate(Emission), iriMask);\nRoughnessOut = saturate(Roughness - edge * saturate(SpecularVariance) * max(FacetScale, 0.0));\nreturn lerp(BaseColor, gemColor, saturate(gemMask + nikkiMask + iriMask));"
      Description="Nikki gemstone ramp: spectral edge colour, glow, and roughness shaping"
      Inputs(0)=(InputName="BaseColor",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFunctionInput_2'"))
      Inputs(1)=(InputName="Roughness",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFunctionInput_3'"))
      Inputs(2)=(InputName="EdgeMask",Input=(Expression="/Script/Engine.MaterialExpressionFresnel'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionFresnel_3'"))
      Inputs(3)=(InputName="GemstoneStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_5'"))
      Inputs(4)=(InputName="RefractionPower",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_6'"))
      Inputs(5)=(InputName="Dispersion",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_7'"))
      Inputs(6)=(InputName="SpecularVariance",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_8'"))
      Inputs(7)=(InputName="FacetScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_9'"))
      Inputs(8)=(InputName="GlowTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(9)=(InputName="RampStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_10'"))
      Inputs(10)=(InputName="RampMidPoint",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_11'"))
      Inputs(11)=(InputName="RampContrast",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_12'"))
      Inputs(12)=(InputName="Iridescence",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_13'"))
      Inputs(13)=(InputName="IridescencePower",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_14'"))
      Inputs(14)=(InputName="Emission",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionScalarParameter_15'"))
      Inputs(15)=(InputName="RampLow",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(16)=(InputName="RampMid",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_3'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(17)=(InputName="RampHigh",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone:MaterialExpressionVectorParameter_4'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      AdditionalOutputs(0)=(OutputName="RoughnessOut")
      MaterialExpressionGuid=FD2427D74720D0FA8E17829F90A2E31C
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/_Scratch/MF_Gemstone.MF_Gemstone'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="RoughnessOut")
