   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionCustom_0'"
      Code="float sweep = WindStrength * sin(Time * WindSpeed * 3.14159 * 2.0);\nfloat phaseU = UV.x * 6.28318;\nfloat fold = FoldingAmount * sin(phaseU * 2.0 + Time * WindSpeed * 6.28318 * 0.75);\nfloat flap = FoldingAmount * 0.35 * sin(phaseU + Time * WindSpeed * 6.28318 * 1.25 + 1.7);\nfloat amp = DrapeMask * saturate(WindStrength * 3.0 + FoldingAmount * 1.5);\nfloat3 offset = WindDirection * (sweep + fold + flap) * amp;\noffset.z += amp * 0.25 * (1.0 + sin(Time * WindSpeed * 3.14159 * 1.6 + phaseU * 0.5));\nreturn offset;"
      Description="MF_ClothWindDrape wind sweep/fold/flap"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="WindStrength",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_2'"))
      Inputs(3)=(InputName="WindSpeed",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_3'"))
      Inputs(4)=(InputName="WindDirection",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_4'"))
      Inputs(5)=(InputName="FoldingAmount",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_5'"))
      Inputs(6)=(InputName="DrapeMask",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_ClothWindDrape.MF_ClothWindDrape:MaterialExpressionFunctionInput_6'"))
      MaterialExpressionEditorX=-1000
