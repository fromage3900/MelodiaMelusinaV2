   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionCustom_3'"
      Code="float d=(Encoded*2.0-1.0)*max(RangeCM,1.0); float w=max(WidthCM,1.0); float aa=max(fwidth(d),1.0); return (1.0-smoothstep(max(w-aa,0.0),w+aa,abs(d)))*saturate(Strength);"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="Encoded",Input=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionTextureSampleParameter2D_23'",OutputIndex=1,Mask=1,MaskR=1))
      Inputs(1)=(InputName="RangeCM",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionScalarParameter_51'"))
      Inputs(2)=(InputName="WidthCM",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionScalarParameter_52'"))
      Inputs(3)=(InputName="Strength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionScalarParameter_55'"))
      MaterialExpressionEditorX=-900
      MaterialExpressionEditorY=-3200
      MaterialExpressionGuid=FD86D935440A30F8D842D7862516FC38
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape'"
      Desc="SnowSDF:FrostBand"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionCustom_2'"
      Code="return Baseline + saturate(SurfaceColor)*saturate(Beat)*saturate(Amount)*clamp(MaxEmission,0.0,10.0);"
      Inputs(0)=(InputName="Baseline",Input=(Expression="/Script/Engine.MaterialExpressionMultiply'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionMultiply_20'"))
      Inputs(1)=(InputName="SurfaceColor",Input=(Expression="/Script/Engine.MaterialExpressionLinearInterpolate'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionLinearInterpolate_8'"))
      Inputs(2)=(InputName="Beat",Input=(Expression="/Script/Engine.MaterialExpressionCollectionParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionCollectionParameter_4'"))
      Inputs(3)=(InputName="Amount",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionScalarParameter_38'"))
      Inputs(4)=(InputName="MaxEmission",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionScalarParameter_50'"))
      MaterialExpressionEditorX=300
      MaterialExpressionEditorY=-550
      MaterialExpressionGuid=164D4D0A4846436E6D4EDD882F2461B1
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape'"
      Desc="LandscapeCymatics:BoundedAdd"
   End Object
   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionCustom_1'"
      Code="// Supplemental meso detail only: never changes source Gaea UVs.\n// Quintic-interpolated value noise, two octaves, world units in centimeters.\n// This is a coverage refinement, not a signed distance field or snow simulation.\nstruct SnowNoise\n{\n    float hash(float2 p)\n    {\n        float3 q=frac(float3(p.xyx)*0.1031);\n        q+=dot(q,q.yzx+33.33);\n        return frac((q.x+q.y)*q.z);\n    }\n    float value(float2 p)\n    {\n        float2 i=floor(p), f=frac(p);\n        float2 u=f*f*f*(f*(f*6.0-15.0)+10.0);\n        return lerp(lerp(hash(i),hash(i+float2(1,0)),u.x),\n                    lerp(hash(i+float2(0,1)),hash(i+float2(1,1)),u.x),u.y)*2.0-1.0;\n    }\n};\nSnowNoise noise;\nfloat2 p=WorldPosition.xy/max(WorldSizeCM,1.0);\nfloat footprint=max(length(ddx(p)),length(ddy(p)));\nfloat a=1.0-smoothstep(0.25,0.75,footprint);\nfloat b=1.0-smoothstep(0.25,0.75,footprint*2.03);\nfloat F=(noise.value(p)*a+0.5*noise.value(p*2.03+float2(17.3,-9.1))*b)/1.5;\nfloat C=saturate(Coverage);\nfloat edge=4.0*C*(1.0-C);\n// Preserve original zero-strength values, including legacy additive coverage.\nreturn Coverage + (saturate(C+edge*saturate(Strength)*F)-C);\n"
      OutputType=CMOT_Float1
      Inputs=
      MaterialExpressionEditorX=-1800
      MaterialExpressionEditorY=-2400
      MaterialExpressionGuid=E3633B7F4232BE5CFE9D45B0BF3894BB
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape'"
      Desc="SnowBreakup:Coverage"
   End Object
   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionCustom_0'"
      Code="\nfloat3 sr,cr;\nsincos(ProjectionRotation*(3.14159265359/180.0),sr,cr);\nfloat3x3 R=float3x3(\ncr.y*cr.z,sr.x*sr.y*cr.z-cr.x*sr.z,cr.x*sr.y*cr.z+sr.x*sr.z,\ncr.y*sr.z,sr.x*sr.y*sr.z+cr.x*cr.z,cr.x*sr.y*sr.z-sr.x*cr.z,\n-sr.y,sr.x*cr.y,cr.x*cr.y);\nfloat2 uv=(mul(R,WorldPosition+ProjectionOffset)*max(abs(ProjectionScale),0.00001)).xy;\nreturn Texture2DSampleGrad(Tex,TexSampler,uv,ddx(uv),ddy(uv)).rgb;\n"
      Inputs=
      MaterialExpressionEditorX=-2000
      MaterialExpressionEditorY=2700
      MaterialExpressionGuid=7E14CC4A4895484B23147EAD5B446FC5
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape'"
      Desc="RockColour:PlanarSample"
   End Object
   Begin Object Name="MaterialExpressionConstant3Vector_9" ExportPath="/Script/Engine.MaterialExpressionConstant3Vector'/Game/EnvSandbox/Materials/Masters/M_Master_Nikki_Landscape.M_Master_Nikki_Landscape:MaterialExpressionConstant3Vector_9'"
      MaterialExpressionEditorX=-700
      MaterialExpressionEditorY=720
