   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Functions/MF_Triplanar_Stable.MF_Triplanar_Stable:MaterialExpressionCustom_0'"
      Code="float3 n = pow(abs(normalize(VertexNormalWS)), max(BlendSharpness, 0.01));\nn /= max(n.x + n.y + n.z, 0.0001);\nfloat3 p = AbsoluteWorldPosition * TriplanarScale;\nfloat3 sx = Texture2DSample(Tex, TexSampler, p.yz).rgb;\nfloat3 sy = Texture2DSample(Tex, TexSampler, p.xz).rgb;\nfloat3 sz = Texture2DSample(Tex, TexSampler, p.xy).rgb;\nreturn sx * n.x + sy * n.y + sz * n.z;"
      Description="Stable triplanar blend using vertex-normal weights"
      Inputs(0)=(InputName="Tex",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_Triplanar_Stable.MF_Triplanar_Stable:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="TriplanarScale",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_Triplanar_Stable.MF_Triplanar_Stable:MaterialExpressionFunctionInput_1'"))
      Inputs(2)=(InputName="BlendSharpness",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_Triplanar_Stable.MF_Triplanar_Stable:MaterialExpressionFunctionInput_2'"))
      MaterialExpressionGuid=024E63E54B34E08937B97FA2F70B44CE
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_Triplanar_Stable.MF_Triplanar_Stable'"
