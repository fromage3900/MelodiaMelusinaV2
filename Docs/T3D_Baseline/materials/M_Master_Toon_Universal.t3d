   Begin Object Name="MaterialExpressionCustom_30" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_30'"
      Code="float3 dreamLumaW = float3(0.2126, 0.7152, 0.0722);\nfloat luma = dot(DreamColor, dreamLumaW);\nif (luma < Threshold) return BaseColor;\nfloat3 dream = DreamColor * DreamWarmth * DreamIntensity;\nfloat3 result;\nint mode = (int)round(Composition);\nif (mode == 0) result = BaseColor + dream;\nelse if (mode == 1) result = max(BaseColor, dream);\nelse result = 1.0 - (1.0 - BaseColor) * (1.0 - dream);\nreturn result;"
      Description="DreamCompositeGate"
      Inputs(0)=(InputName="DreamColor",Input=(Expression="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_1'"))
      Inputs(1)=(InputName="BaseColor",Input=(Expression="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionStaticSwitchParameter_17'"))
      Inputs(2)=(InputName="DreamWarmth")
      Inputs(3)=(InputName="DreamIntensity")
      Inputs(4)=(InputName="Composition")
      Inputs(5)=(InputName="Threshold")
      MaterialExpressionGuid=D371D1E34BB7D1D72B22ACA5739C38D9
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_31" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_31'"
      Code="// SDF face shadow: darken shadows on the face region\n// FaceSDF texture: white=lit area, black=shadow area\nfloat mask = 1.0 - SDFValue;            // 0 = lit, 1 = shadowed\nreturn mask * FaceSDFStrength;\n"
      OutputType=CMOT_Float1
      Description="FaceSDFMask"
      Inputs(0)=(InputName="SDFValue",Input=(Expression="/Script/Engine.MaterialExpressionComponentMask'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionComponentMask_9'"))
      Inputs(1)=(InputName="FaceSDFStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_85'"))
      MaterialExpressionEditorX=-1940
      MaterialExpressionEditorY=760
      MaterialExpressionGuid=61805C3349B9CC4BA0E8FD99CFAF289D
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_4" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_4'"
      Code="float2 p=UV*Scale;\nfloat t=Time*Speed;\nfloat2 flow=float2(sin(p.y*1.3+t),cos(p.x*1.7-t))*0.5;\np+=flow;\nfloat n=0.5+0.5*sin(p.x*3.1+p.y*2.3+sin(p.x*1.7-p.y*1.1+t));\nreturn pow(saturate(n),Sharp);"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTime_3'"))
      Inputs(2)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_31'"))
      Inputs(3)=(InputName="Speed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_32'"))
      Inputs(4)=(InputName="Sharp",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_33'"))
      MaterialExpressionEditorX=-2340
      MaterialExpressionEditorY=3592
      MaterialExpressionGuid=801F3BF24615F2A36C7FF3A88B83FACE
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_5" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_5'"
      Code="float2 p=UV*Scale;\nfloat2 cell=floor(p);\nfloat2 f=frac(p);\nfloat h=frac(sin(dot(cell,float2(127.1,311.7)))*43758.5453);\nfloat2 c=float2(h,frac(h*57.0));\nfloat d=length(f-c);\nfloat star=pow(saturate(1.0-d*Size),Sharp);\nfloat tw=0.5+0.5*sin(Time*Speed+h*6.283);\nreturn star*tw;"
      OutputType=CMOT_Float1
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTextureCoordinate_1'"))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTime_3'"))
      Inputs(2)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_35'"))
      Inputs(3)=(InputName="Size",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_36'"))
      Inputs(4)=(InputName="Sharp",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_37'"))
      Inputs(5)=(InputName="Speed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_38'"))
      MaterialExpressionEditorX=-2080
      MaterialExpressionEditorY=3430
      MaterialExpressionGuid=880E45994C774CDFD15CCD95CB80CBAF
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_6" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_6'"
      Code="float2 Pivot = float2(0.5, 0.5);\nfloat2 c = UV - Pivot;\nfloat ang = Rotation * 6.28318530718;\nfloat s, co;\nsincos(ang, s, co);\nfloat2 r = float2(co * c.x - s * c.y, s * c.x + co * c.y);\nreturn r + Pivot + float2(OffsetU, OffsetV);"
      OutputType=CMOT_Float2
      Description="UVManip_247"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionLinearInterpolate'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionLinearInterpolate_247'"))
      Inputs(1)=(InputName="Rotation",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_56'"))
      Inputs(2)=(InputName="OffsetU",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_57'"))
      Inputs(3)=(InputName="OffsetV",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_58'"))
      MaterialExpressionEditorX=-250
      MaterialExpressionEditorY=-1800
      MaterialExpressionGuid=4F2E0AAA494923845013B1A2CE0ED229
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_7" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_7'"
      Code="float3 p = WorldPosition * TriplanarWorldScale;\nfloat3 q = WorldPosition / max(MacroScale, 1.0);\nfloat detailTiling = max(DetailTiling, 0.01);\nfloat macroA = sin(dot(q, float3(0.73, 0.31, -0.61)) * 6.2831853);\nfloat macroB = sin(dot(q, float3(-0.29, 0.89, 0.37)) * 6.2831853 + 1.618);\nfloat macroC = sin(dot(q, float3(0.53, -0.47, 0.79)) * 6.2831853 + 0.618);\nfloat3 detailQ = q * detailTiling;\nfloat3 detailPhase = float3(sin(dot(detailQ, float3(1.17,-0.41,0.23))*6.2831853),sin(dot(detailQ,float3(-0.37,1.09,0.51))*6.2831853+2.094),sin(dot(detailQ,float3(0.43,0.19,1.21))*6.2831853+4.189));\nfloat3 macroDirection = normalize(float3(macroA-macroB, macroB-macroC, macroC-macroA) + 0.0001);\nfloat amplitude = saturate(MacroVariationStrength) * (0.018 + 0.082 * saturate(DetailStrength));\nreturn p + macroDirection * amplitude + detailPhase * amplitude * 0.35;"
      Description="Shared macro lattice for triplanar coordinates: ties macro/detail controls to projection breakup"
      Inputs(0)=(InputName="WorldPosition",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionWorldPosition_3'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="TriplanarWorldScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_6'"))
      Inputs(2)=(InputName="MacroVariationStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_806'"))
      Inputs(3)=(InputName="MacroScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_807'"))
      Inputs(4)=(InputName="DetailTiling",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_808'"))
      Inputs(5)=(InputName="DetailStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_809'"))
      MaterialExpressionEditorX=-2860
      MaterialExpressionGuid=FACBB2FE42705F701DC13D9FC103BE80
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
