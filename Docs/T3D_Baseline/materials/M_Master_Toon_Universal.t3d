   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_1'"
      Code="float t=saturate(Rim);\nreturn 0.5+0.5*cos(6.28318*(t*Cycles+float3(0.0,0.33,0.67)));"
      Description="DreamRimSpectral"
      Inputs(0)=(InputName="Rim",Input=(Expression="/Script/Engine.MaterialExpressionFresnel'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionFresnel_0'"))
