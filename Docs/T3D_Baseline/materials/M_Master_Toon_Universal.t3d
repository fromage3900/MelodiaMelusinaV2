      MaterialExpressionGuid=30EA31CE436F19A2CDFD05B4A978B0A2
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
