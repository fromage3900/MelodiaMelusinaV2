      Inputs(6)=(InputName="Cycles",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_26'"))
      MaterialExpressionEditorX=-2600
      MaterialExpressionEditorY=3092
      MaterialExpressionGuid=8E10675440816D7FE5FB74A2254804AC
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
