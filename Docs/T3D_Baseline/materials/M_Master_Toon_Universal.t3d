   End Object
   Begin Object Name="MaterialExpressionCustom_12" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_12'"
      Code="float2 Pivot = float2(0.5, 0.5);\nfloat2 c = UV - Pivot;\nfloat ang = Rotation * 6.28318530718;\nfloat s, co;\nsincos(ang, s, co);\nfloat2 r = float2(co * c.x - s * c.y, s * c.x + co * c.y);\nreturn r + Pivot + float2(OffsetU, OffsetV);"
      OutputType=CMOT_Float2
      Description="UVManip_928"
