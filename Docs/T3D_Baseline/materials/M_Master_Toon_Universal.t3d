   End Object
   Begin Object Name="MaterialExpressionCustom_15" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_15'"
      MaterialExpressionEditorX=-9000
      MaterialExpressionEditorY=-9000
      MaterialExpressionGuid=F4C76F3047F185EECD9EF3A63216CCFE
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_16" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_16'"
      MaterialExpressionEditorX=-9900
      MaterialExpressionEditorY=-9900
      MaterialExpressionGuid=FED5EB534BB1290A65FC628CC671125D
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_2" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_2'"
      Code="float3 dir=normalize(float3(0.6,0.2,0.35));\nfloat phase=dot(WorldPos*0.001,dir)*Scale + Time*Speed;\nreturn 0.5+0.5*cos(6.28318*(phase*Cycles + float3(0.0,0.33,0.67)));"
      Inputs(0)=(InputName="WorldPos",Input=(Expression="/Script/Engine.MaterialExpressionWorldPosition'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionWorldPosition_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTime_0'"))
      Inputs(2)=(InputName="Scale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_17'"))
      Inputs(3)=(InputName="Speed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_16'"))
      Inputs(4)=(InputName="Cycles",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_18'"))
      MaterialExpressionEditorX=-2860
      MaterialExpressionEditorY=3092
      MaterialExpressionGuid=E7EF05BD4357EC6DA08E2A91F1DD3C50
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_20" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_20'"
      Code="float2 wUV = UV * WeaveScale;\nfloat warp = 0.5 + 0.5 * sin(wUV.x * 6.28318);\nfloat weft = 0.5 + 0.5 * sin(wUV.y * 6.28318);\nfloat pattern = warp * weft;\nfloat3 n;\nn.xy = float2(ddx(pattern), ddy(pattern)) * WeaveStrength;\nn.z = 1.0;\nreturn normalize(n);"
      Description="FabricWeaveNormal"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTextureCoordinate_5'"))
      Inputs(1)=(InputName="WeaveScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_68'"))
      Inputs(2)=(InputName="WeaveStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_69'"))
      MaterialExpressionEditorX=240
      MaterialExpressionEditorY=240
      MaterialExpressionGuid=AF5799064342314A4A45FC980D80F026
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_21" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_21'"
      Code="float r = saturate(Rim + Disp);\nfloat g = saturate(Rim);\nfloat b = saturate(Rim - Disp);\nreturn float3(r*r, g*g, b*b);"
      Description="GemstoneDispersion"
      Inputs(0)=(InputName="Rim")
      Inputs(1)=(InputName="Disp")
      MaterialExpressionEditorX=-1720
      MaterialExpressionEditorY=920
      MaterialExpressionGuid=746A74AF45C82C96DFA63E9AFB164FF2
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_22" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_22'"
      Code="float luma = dot(DreamColor, float3(0.2126, 0.7152, 0.0722));\nif (luma < Threshold) return BaseColor;\nfloat3 result;\nint mode = (int)round(Composition);\nif (mode == 0) result = BaseColor + DreamColor * DreamIntensity;\nelse if (mode == 1) result = max(BaseColor, DreamColor * DreamIntensity);\nelse result = 1.0 - (1.0 - BaseColor) * (1.0 - DreamColor * DreamIntensity);\nreturn result;"
      Description="DreamCompositor"
      Inputs(0)=(InputName="DreamColor")
      Inputs(1)=(InputName="BaseColor")
      Inputs(2)=(InputName="DreamIntensity")
      Inputs(3)=(InputName="Composition")
      Inputs(4)=(InputName="Threshold")
      MaterialExpressionEditorX=-1720
      MaterialExpressionEditorY=1400
      MaterialExpressionGuid=25C7EF014BDD83F62A7892BCD5D5630E
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_23" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_23'"
      Code="float wrap = 1.0 + SkinSSSRadius;\nfloat sss = saturate((NdotL + SkinSSSRadius) / (wrap * wrap));\nreturn lerp(NdotL, sss, SkinSSSStrength);"
      OutputType=CMOT_Float1
      Description="SkinSSS"
      Inputs(0)=(InputName="NdotL",Input=(Expression="/Script/Engine.MaterialExpressionDotProduct'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionDotProduct_38'"))
      Inputs(1)=(InputName="SkinSSSStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_87'"))
      Inputs(2)=(InputName="SkinSSSRadius",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_88'"))
      MaterialExpressionEditorX=-1720
      MaterialExpressionEditorY=2560
      MaterialExpressionGuid=4E46D248427E48BFCE5EE4A2B7600B24
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_24" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_24'"
      Code="float a = 0.0;\n// Silk (2), Satin (3), Sequins (7) get strong anisotropy\na += smoothstep(1.5, 2.5, FabricType) * 0.9;         // silk\na += smoothstep(2.5, 3.5, FabricType) * 0.95;        // satin\na += smoothstep(6.5, 7.5, FabricType) * 0.7;         // sequins\na += smoothstep(0.5, 1.5, FabricType) * 0.15;        // cotton slight\nreturn saturate(a + FabricAnisoLevel);\n"
      OutputType=CMOT_Float1
      Description="FabricAnisoGate"
      Inputs(0)=(InputName="FabricType",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_66'"))
      Inputs(1)=(InputName="FabricAnisoLevel",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_67'"))
      MaterialExpressionEditorX=500
      MaterialExpressionEditorY=120
      MaterialExpressionGuid=62506AC8480F75CF187B7B8C1C5D0821
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_25" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_25'"
      Code="float eta = saturate(IOR);\nfloat F0 = ((eta - 1.0) * (eta - 1.0)) / ((eta + 1.0) * (eta + 1.0));\nreturn float3(F0, F0, F0) * GemstoneTint;\n"
      Description="GemstoneF0"
      Inputs(0)=(InputName="IOR",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_70'"))
      Inputs(1)=(InputName="GemstoneTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionVectorParameter_15'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      MaterialExpressionEditorX=1700
      MaterialExpressionEditorY=-200
      MaterialExpressionGuid=B7EC1BE84565B03E3241D19BEE4094B2
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_26" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_26'"
      Code="// sparkle: hash-snapped grid in view space\nfloat2 ip = floor(Parameters.WorldPosition.xz * GlintScale);\nfloat h = frac(sin(dot(ip, float2(12.9898, 78.233))) * 43758.5453);\nfloat sparkle = step(0.995 - GlintIntensity * 0.004, h);\nreturn sparkle * GemstoneTint * ChromaticStrength;\n"
      Description="GemstoneEmissive"
      Inputs(0)=(InputName="GlintScale",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_35'"))
      Inputs(1)=(InputName="GlintIntensity",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_73'"))
      Inputs(2)=(InputName="GemstoneTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionVectorParameter_15'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(3)=(InputName="ChromaticStrength",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_74'"))
      MaterialExpressionEditorX=1700
      MaterialExpressionEditorY=40
      MaterialExpressionGuid=940A46BB49BCCEEB461585BAE403FAD0
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_27" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_27'"
      Code="float3 dreamLumaW = float3(0.2126, 0.7152, 0.0722);\nfloat luma = dot(DreamColor, dreamLumaW);\nif (luma < Threshold) return BaseColor;\nfloat3 dream = DreamColor * DreamWarmth * DreamIntensity;\nfloat3 result;\nint mode = (int)round(Composition);\nif (mode == 0) result = BaseColor + dream;\nelse if (mode == 1) result = max(BaseColor, dream);\nelse result = 1.0 - (1.0 - BaseColor) * (1.0 - dream);\nreturn result;"
      Description="DreamCompositeGate"
      MaterialExpressionGuid=346E44524A9E751C49834A8286CF7DA8
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_28" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_28'"
      Code="float upDot = abs(dot(normalize(Parameters.WorldNormal), float3(0,0,1)));\nfloat steepness = 1.0 - upDot;\nreturn smoothstep(SlopeStart, SlopeEnd, steepness);\n"
      OutputType=CMOT_Float1
      Description="TriplanarSlopeMask"
      Inputs(0)=(InputName="SlopeStart",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_61'"))
      Inputs(1)=(InputName="SlopeEnd",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_62'"))
      MaterialExpressionEditorX=3900
      MaterialExpressionEditorY=2350
      MaterialExpressionGuid=431BC4D54B23395DFF3A1AAFA7CA9FCD
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_29" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_29'"
      Code="return SlopeMask * Active;\n"
      OutputType=CMOT_Float1
      Description="TriplanarGate"
      Inputs(0)=(InputName="SlopeMask",Input=(Expression="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_28'"))
      Inputs(1)=(InputName="Active",Input=(Expression="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionStaticSwitchParameter_3'"))
      MaterialExpressionEditorX=4100
      MaterialExpressionEditorY=2400
      MaterialExpressionGuid=79E60D5F40C54C54301FC0A8F24295ED
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_3" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_3'"
      Code="float2 p=UV-0.5;\nfloat ang=atan2(p.y,p.x);\nfloat rad=saturate(length(p)*2.0);\nfloat seg=6.2831853/Sides;\nfloat a=abs(frac(ang/seg)-0.5)*2.0;\na=frac(a+Time*Speed*0.1);\nfloat ring=0.5+0.5*sin(rad*Rings*6.2831853-Time*Speed);\nfloat petal=pow(saturate(1.0-abs(a*2.0-1.0)),Sharp);\nfloat glyph=saturate(ring*petal)*saturate(1.0-rad);\nfloat3 col=0.5+0.5*cos(6.2831853*(rad*Cycles+float3(0.0,0.33,0.67)));\nreturn col*glyph;"
      Inputs(0)=(InputName="UV",Input=(Expression="/Script/Engine.MaterialExpressionTextureCoordinate'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTextureCoordinate_0'"))
      Inputs(1)=(InputName="Time",Input=(Expression="/Script/Engine.MaterialExpressionTime'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionTime_2'"))
      Inputs(2)=(InputName="Sides",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_22'"))
      Inputs(3)=(InputName="Rings",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_23'"))
      Inputs(4)=(InputName="Speed",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionScalarParameter_24'"))
