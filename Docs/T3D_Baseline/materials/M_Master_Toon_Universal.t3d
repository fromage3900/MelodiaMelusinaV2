   Begin Object Name="MaterialExpressionCustom_13" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_13'"
      Code="float3 worldPos = Parameters.WorldPosition;\nfloat3 normal = abs(Parameters.WorldNormal);\nfloat3 weights = pow(normal, TriplanarSharpness);\nweights /= dot(weights, float3(1,1,1));\n\nfloat2 uvX = worldPos.yz * TriplanarTiling;\nfloat2 uvY = worldPos.xz * TriplanarTiling;\nfloat2 uvZ = worldPos.xy * TriplanarTiling;\n\nfloat4 triUV1 = float4(uvX, uvY);\nfloat4 triUV2 = float4(uvZ.xy, weights.xy);\nfloat output_unused = weights.z;\n"
      OutputType=CMOT_Float4
      Description="TriplanarUVs"
      Inputs(0)=(InputName="TriplanarSharpness")
      Inputs(1)=(InputName="TriplanarTiling")
      MaterialExpressionEditorX=-1600
      MaterialExpressionEditorY=200
      MaterialExpressionGuid=C8B1AACA473D97F37B9533A25C55D996
      Material="/Script/Engine.Material'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal'"
   End Object
   Begin Object Name="MaterialExpressionCustom_14" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Masters/M_Master_Toon_Universal.M_Master_Toon_Universal:MaterialExpressionCustom_14'"
      MaterialExpressionEditorX=740
      MaterialExpressionEditorY=100
      MaterialExpressionGuid=8ABE638D4BD1AA2B3E358A87C83E4DE0
