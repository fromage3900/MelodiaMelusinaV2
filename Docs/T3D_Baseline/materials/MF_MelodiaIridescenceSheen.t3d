   Begin Object Name="MaterialExpressionFresnel_0" ExportPath="/Script/Engine.MaterialExpressionFresnel'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionFresnel_0'"
      MaterialExpressionGuid=93515EDB4CF504B139B6B9A0D39F493E
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen'"
