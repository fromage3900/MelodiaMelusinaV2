   Begin Object Name="MaterialExpressionCustom_0" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionCustom_0'"
      Code="float edge = pow(saturate(EdgeMask + IridescenceBias), max(IridescencePower, 0.01));\nfloat interiorAtten = lerp(1.0, edge, saturate(IridescenceRoughnessAtten));\nfloat spectralT = saturate(edge * 1.35 + IridescenceBias);\nfloat3 spectral = lerp(DeepTint, MidTint, saturate(spectralT * 2.0));\nspectral = lerp(spectral, EdgeTint, saturate((spectralT - 0.5) * 2.0));\nfloat iriMask = saturate(Iridescence) * edge * interiorAtten;\nfloat sheenEdge = pow(saturate(EdgeMask + SheenBias), max(SheenPower, 0.01));\nfloat sheenBand = smoothstep(saturate(1.0 - SheenWidth), 1.0, sheenEdge) * saturate(FabricSheen);\nfloat3 sheen = SheenTint * sheenBand;\nEmissiveOut = spectral * (iriMask * saturate(IridescenceEmission)) + sheen * 0.18;\nreturn lerp(BaseColor, spectral + sheen, iriMask);"
      Description="Three-stop spectral edge blend with independent sheen and emission"
      Inputs(0)=(InputName="BaseColor",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="EdgeMask",Input=(Expression="/Script/Engine.MaterialExpressionFresnel'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionFresnel_0'"))
      Inputs(2)=(InputName="Iridescence",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_0'"))
      Inputs(3)=(InputName="IridescencePower",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_1'"))
      Inputs(4)=(InputName="IridescenceBias",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_2'"))
      Inputs(5)=(InputName="IridescenceRoughnessAtten",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_3'"))
      Inputs(6)=(InputName="IridescenceEmission",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_4'"))
      Inputs(7)=(InputName="DeepTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionVectorParameter_0'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(8)=(InputName="MidTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionVectorParameter_1'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(9)=(InputName="EdgeTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionVectorParameter_2'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      Inputs(10)=(InputName="FabricSheen",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_5'"))
      Inputs(11)=(InputName="SheenPower",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_6'"))
      Inputs(12)=(InputName="SheenWidth",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_7'"))
      Inputs(13)=(InputName="SheenBias",Input=(Expression="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_8'"))
      Inputs(14)=(InputName="SheenTint",Input=(Expression="/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionVectorParameter_3'",Mask=1,MaskR=1,MaskG=1,MaskB=1))
      AdditionalOutputs(0)=(OutputName="EmissiveOut",OutputType=CMOT_Float3)
      MaterialExpressionGuid=A99EDCE94E910C069FF5F895CE263659
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen'"
      bShowOutputNameOnPin=True
      Outputs(0)=(OutputName="return")
      Outputs(1)=(OutputName="EmissiveOut")
   End Object
