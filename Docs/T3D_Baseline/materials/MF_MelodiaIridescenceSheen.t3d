e.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionVectorParameter_2'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_5'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_6'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_7'","/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionScalarParameter_8'","/Script/Engine.MaterialExpressionVectorParameter'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionVectorParameter_3'","/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Functions/MF_MelodiaIridescenceSheen.MF_MelodiaIridescenceSheen:MaterialExpressionCustom_0'"))
