   Begin Object Name="MaterialExpressionCustom_1" ExportPath="/Script/Engine.MaterialExpressionCustom'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionCustom_1'"
      Code="FToonGBufferData ToonGBuffer = (FToonGBufferData)0;\r\n\r\nToonGBuffer.ShadingFeatureID = ShadingFeatureID;\r\nToonGBuffer.MainLightShadowColor = MainLightShadowColor;\r\nToonGBuffer.DiffuseColorRampIndex = DiffuseColorRampIndex;\r\nToonGBuffer.DiffuseColorRampUVOffset = DiffuseColorRampUVOffset;\r\nToonGBuffer.SpecularColor = SpecularColor;\r\nToonGBuffer.SpecularColorRampIndex = SpecularColorRampIndex;\r\nToonGBuffer.SpecularColorRampUVOffset = SpecularColorRampUVOffset;\r\nToonGBuffer.ReflectionIntensity = ReflectionIntensity;\r\nToonGBuffer.RimLightIntensity = RimLightIntensity;\r\nToonGBuffer.RimLightWidth = RimLightWidth;\r\nToonGBuffer.FacialShadowSdfLeft = FacialShadowSdfLeft;\r\nToonGBuffer.FacialShadowSdfRight = FacialShadowSdfRight;\r\nToonGBuffer.Stencil = Stencil;\r\nToonGBuffer.RayTracingShadowFlag = RayTracingShadowFlag;\r\n\r\nEncodeToonGBufferDataToMaterialAttribute(ToonGBuffer, \r\n\tOutMooaEncodedAttribute0, OutMooaEncodedAttribute1, OutMooaEncodedAttribute2, OutMooaEncodedAttribute3, OutMooaEncodedAttribute4);\r\nreturn 0;"
      Inputs(0)=(InputName="ShadingFeatureID",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_0'"))
      Inputs(1)=(InputName="MainLightShadowColor",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_24'"))
      Inputs(2)=(InputName="DiffuseColorRampIndex",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_26'"))
      Inputs(3)=(InputName="DiffuseColorRampUVOffset",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_4'"))
      Inputs(4)=(InputName="SpecularColor",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_30'"))
      Inputs(5)=(InputName="SpecularColorRampIndex",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_25'"))
      Inputs(6)=(InputName="SpecularColorRampUVOffset",Input=(Expression="/Script/Engine.MaterialExpressionFunctionInput'/Game/EnvSandbox/Materials/Functions/MF_MooaEncodeAttributes.MF_MooaEncodeAttributes:MaterialExpressionFunctionInput_28'"))
