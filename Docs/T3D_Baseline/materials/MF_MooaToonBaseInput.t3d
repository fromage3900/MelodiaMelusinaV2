   Begin Object Name="MaterialExpressionScalarParameter_25" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_25'"
      DefaultValue=1.000000
      SliderMax=1.000000
      PrimitiveDataIndex=2
      ParameterName="AO Intensity"
      ExpressionGUID=BAD1EA9D43388E46384D55A5D2800B71
      Group="10 - Diffuse"
      SortPriority=35
      MaterialExpressionEditorX=-6704
      MaterialExpressionEditorY=-224
      MaterialExpressionGuid=728763A045727CAD0EE253A37E11FCB2
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="通过AO可以使某些区域始终处于阴影中.\r\n\r\nAO Map: 0为被遮挡, 1为被照亮. 默认为1.\r\n颜色空间: 线性.\r\n\r\n\r\nAO allows certain areas to be always in shadow.\r\n\r\nAO Map: 0 means occluded, 1 means illuminated. Default is 1.\r\nColor space: linear."
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_24" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_24'"
      DefaultValue=0.500000
      SliderMax=1.000000
      PrimitiveDataIndex=4
      ParameterName="Rim Light Intensity"
      ExpressionGUID=3F0508CA44F1600F4B694EA63BA1D1F0
      Group="12 - Rim Light"
      SortPriority=40
      MaterialExpressionEditorX=-6672
      MaterialExpressionEditorY=3040
      MaterialExpressionGuid=728763A045727CAD0EE253A37E11FCB2
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="屏幕空间深度测试边缘光强度.\r\n与传统的基于法线方向与视线方向的角度(N dot V)的边缘光不同, 屏幕空间边缘光的宽度与表面曲率无关, 看起来更加扁平化.\r\n可以用控制台命令调整更多全局参数.\r\n\r\n\r\nScreen Space Depth Test Rim Light Intensity.\r\nDifferent from the traditional rim light based on the angle between the normal direction and the view direction (N dot V), the width of the screen space rim light has nothing to do with the surface curvature and looks flatter.\r\nMore global parameters can be adjusted using console variables."
   End Object
