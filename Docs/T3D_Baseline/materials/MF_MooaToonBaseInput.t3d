   Begin Object Name="MaterialExpressionComment_15" ExportPath="/Script/Engine.MaterialExpressionComment'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionComment_15'"
      SizeX=912
      SizeY=240
      Text="Toon Material should always output Tangent in World Space.\r\nMooaToon uses 0 as the default value for Tangent and converts it to World Tangent before output.\r\nNon-zero values are output as-is."
      MaterialExpressionEditorX=-4483
