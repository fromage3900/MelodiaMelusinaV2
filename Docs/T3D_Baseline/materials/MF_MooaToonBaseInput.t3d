      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_10" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_10'"
