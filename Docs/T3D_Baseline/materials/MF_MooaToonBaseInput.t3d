   Begin Object Name="MaterialExpressionStaticSwitchParameter_28" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionStaticSwitchParameter_28'"
      A=(Expression="/Script/Engine.MaterialExpressionNamedRerouteUsage'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionNamedRerouteUsage_48'")
      B=(Expression="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionStaticSwitchParameter_27'")
      ParameterName="Use Vertex Color Instead Mask Map"
      ExpressionGUID=471387834F59DFAA4FB4FEB181DF9ADE
      Group="01 - Global Mask Map"
      SortPriority=40
      MaterialExpressionEditorX=-8586
      MaterialExpressionEditorY=-254
      MaterialExpressionGuid=0103345D45FF91B79DBF4D80CB94A113
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="使用顶点色替代Mask Map可以减少带宽成本并提升特写镜头的渲染精度, 但模型的制作难度更高.\r\n经验丰富或者对性能/质量要求极高的团队可以使用.\r\n\r\n\r\nUsing vertex color instead of Mask Map can reduce bandwidth cost and improve the rendering accuracy of close-ups, but the model is more difficult to produce.\r\nCan be used by teams that are experienced or have extremely high performance/quality requirements."
   End Object
   Begin Object Name="MaterialExpressionStaticSwitchParameter_27" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionStaticSwitchParameter_27'"
      A=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionTextureSampleParameter2D_22'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1)
      B=(Expression="/Script/Engine.MaterialExpressionTextureSampleParameter2D'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionTextureSampleParameter2D_20'",OutputIndex=5,Mask=1,MaskR=1,MaskG=1,MaskB=1,MaskA=1)
      ParameterName="Enable Per Texture Sampler"
      ExpressionGUID=2ACB538941D71064AB258DA6668EB6AB
      Group="00 - Global Settings"
      MaterialExpressionEditorX=-9438
      MaterialExpressionEditorY=-222
      MaterialExpressionGuid=B51FAA92477BD0DC46097FB676B5BE69
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="由于某些平台存在采样器数量限制(例如DX11限制16个采样器), 所以所有贴图采样默认使用共享的Bilinear采样器.\r\n但如果你希望逐贴图修改采样器类型(例如你的项目是像素风格而且不希望贴图的像素被模糊), 那么你需要打开此选项, 并且要小心使用Material Layer以避免超过采样器数量上限.\r\n\r\n\r\nDue to the limit on the number of samplers on some platforms (for example, DX11 is limited to 16 samplers), all texture sampling uses the shared Bilinear sampler by default.\r\nBut if you want to change the sampler type on a per-texture basis (for example, your project is pixelated and you don\'t want the pixels of the texture to be blurred), then you need to turn this option on, and use Material Layer carefully to avoid exceeding the sampler limit."
   End Object
