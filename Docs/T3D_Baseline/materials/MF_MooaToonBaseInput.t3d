   Begin Object Name="MaterialExpressionStaticSwitchParameter_4" ExportPath="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionStaticSwitchParameter_4'"
      A=(Expression="/Script/Engine.MaterialExpressionConstant'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionConstant_8'")
      B=(Expression="/Script/Engine.MaterialExpressionConstant'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionConstant_7'")
      ParameterName="Use Screen Space Depth Test Hair Shadow"
      ExpressionGUID=125105B34E865F9F87AFFA994C9B7EFB
      Group="13 - Ray Tracing Shadow"
      SortPriority=80
      MaterialExpressionEditorX=-6240
      MaterialExpressionEditorY=4864
      MaterialExpressionGuid=6F3F9EF44D8AF80F5B40F19D2DA1754D
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="启用屏幕空间深度测试发影.\r\n注意: 需要在脸的材质而不是头发的材质上启用!\r\n\r\n这种方法能够产生和头发剪影一致且等宽的发影, 极具平面和手绘质感.\r\n必须正确设置脸和头发的ID.\r\n\r\nEnable Screen Space Depth Test Shadow.\r\nNote: This needs to be enabled on the face material, not the hair material!\r\n\r\nThis method can produce hair shadows that is consistent with the hair silhouette and has the same width, giving it a flat and hand-drawn look.\r\nFace and hair IDs must be set correctly."
   End Object
