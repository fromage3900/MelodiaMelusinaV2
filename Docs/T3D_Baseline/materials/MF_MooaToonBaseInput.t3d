   Begin Object Name="MaterialExpressionScalarParameter_15" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_15'"
      SliderMax=1.000000
      ParameterName="Specular"
      ExpressionGUID=8B6F62284C6E6B3358E63B87CB6D3011
      Group="11 - Specular"
      SortPriority=1
      MaterialExpressionEditorX=-1040
      MaterialExpressionEditorY=1376
      MaterialExpressionGuid=DBDEBBA54816A0EE58C06AB1E7E1306D
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_14" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_14'"
      DefaultValue=1.000000
      SliderMax=255.000000
      ParameterName="Diffuse Color Ramp Index"
      ExpressionGUID=2C2D663A4EB9AB4D37FF20B020633311
      Group="10 - Diffuse"
      SortPriority=0
      MaterialExpressionEditorX=-6688
      MaterialExpressionEditorY=-480
      MaterialExpressionGuid=417ECA404915A08462FC0F93B58DC034
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="选择使用那个Diffuse Color Ramp.\r\nRamp的横轴是光照方向和表面法线的角度(N dot L), 0为背光面, 0.5为明暗交界线, 1为正光面.\r\nRGB通道为漫反射颜色.\r\nA通道为阴影衰减, 1为被照亮, 0为被遮挡. 用于区分Base Color和Shadow Color.\r\n\r\n现在MooaToon使用Global Diffuse/Specular Color Ramps来描述表面的多光源着色结果, 这意味着使用同一套输入你既可以实现基于物理的着色, 也可以实现完全自定义的风格化着色.\r\n你可以在Project Settings > Engine > MooaToon中找到默认的Ramp Atlas, 其中存放了所有可供选择的Ramp, 要使用某个Ramp你需要在这里输入其Index.\r\n如果要添加新的Ramp, 请先将默认的Ramp Atlas复制一份, 然后在Project Settings中修改Ramp Atlas为复制的, 以避免在更新MooaToon的时候产生冲突.\r\n\r\n\r\nChoose which Diffuse Color Ramp to use.\r\nThe horizontal axis of Ramp is the angle between light direction and surface normal (N dot L), 0 is the backlight surface, 0.5 is the boundary between light and dark, and 1 is the front light surface.\r\nThe RGB channel is the diffuse color.\r\nThe A channel is shadow attenuation, 1 means illuminated, 0 means occluded. Used to distinguish Base Color and Shadow Color.\r\n\r\nMooaToon now uses Global Diffuse/Specular Color Ramps to describe the multi-light shading results of the surface, which means that using the same set of inputs you can achieve both physically based shading and completely customized stylized shading.\r\nYou can find the default Ramp Atlas in Project Settings > Engine > MooaToon, which stores all available Ramps. To use a Ramp, you need to enter its Index here.\r\nIf you want to add a new Ramp, please first copy the default Ramp Atlas, and then modify the Ramp Atlas to be copied in Project Settings to avoid conflicts when updating MooaToon."
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_13" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_13'"
      ParameterName="Global UV Offset X"
      ExpressionGUID=851CEDBB424966336945C0872EED146C
      Group="00 - Global Settings"
      SortPriority=102
      MaterialExpressionEditorX=-10030
      MaterialExpressionEditorY=-3358
      MaterialExpressionGuid=9D8AFFF1418C8BD6E4994D8838776762
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_12" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_12'"
      SliderMax=256.000000
      ParameterName="ID Offset"
      ExpressionGUID=58A5A3574E0A05FE87D295BFF24ED2CB
      Group="13 - Ray Tracing Shadow"
      SortPriority=50
      MaterialExpressionEditorX=-6528
      MaterialExpressionEditorY=3872
      MaterialExpressionGuid=CEDE0479401885F164E4E7B9678AB0C1
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="可以在没有ID Map或顶点色输入的情况下使用ID偏移来指定整个材质的ID.\r\n\r\nMooaToon使用ID来区分同角色的不同部位, 以精确控制每个部位是否投射阴影.\r\n或者用不同ID区分不同角色, 以实现同角色的模型之间没有自阴影, 但不同角色之间可以相互投影.\r\n\r\n\r\nID offsets can be used to specify IDs for the entire material without ID Map or vertex color input.\r\n\r\nMooaToon uses ID to distinguish different parts of the same character to precisely control whether each part casts a shadow.\r\nOr use different IDs to distinguish different characters, so that there is no self-shadowing between models of the same character, but different characters can cast shadows each other."
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_11" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_11'"
      SliderMax=1.000000
      PrimitiveDataIndex=4
      ParameterName="Reflection"
      ExpressionGUID=7E7B622F4589581B8F15C8A2D21470EA
      Group="11 - Specular"
      SortPriority=2
      MaterialExpressionEditorX=-2239
