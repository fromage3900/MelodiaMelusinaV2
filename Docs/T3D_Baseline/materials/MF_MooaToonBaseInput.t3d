      B=(Expression="/Script/Engine.MaterialExpressionStaticSwitchParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionStaticSwitchParameter_5'")
      ParameterName="Enable Feature Kajiya Hair Specular"
      ExpressionGUID=8A3013744B027F70F0604F8C9F275C2B
      Group="00 - Global Settings"
      SortPriority=60
      MaterialExpressionEditorX=-6288
      MaterialExpressionEditorY=-832
      MaterialExpressionGuid=A3BF8B3D4454B6425DEE85B3CEF37A96
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="使用风格化的Kajiya头发高光着色模型, 需要配合在Houdini中烘焙的切线使用, 用于实现手绘质感的头发以及自定义高光流动方向.\r\n同一时间只能启用一种Feature.\r\n\r\n\r\nUse the stylized Kajiya hair highlight shading model, which needs to be used with tangents baked in Houdini to achieve hand-painted textured hair and custom highlight flow direction.\r\nOnly one Feature can be enabled at the same time."
   End Object
