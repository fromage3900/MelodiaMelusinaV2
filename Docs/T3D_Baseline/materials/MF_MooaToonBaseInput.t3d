   End Object
   Begin Object Name="MaterialExpressionScalarParameter_28" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_28'"
      DefaultValue=240.000000
      SliderMax=256.000000
      ParameterName="Hair ID"
      ExpressionGUID=4D30477440B67EE0364300B83AF20ABA
      Group="13 - Ray Tracing Shadow"
      SortPriority=82
      MaterialExpressionEditorX=-6368
      MaterialExpressionEditorY=4304
      MaterialExpressionGuid=CEDE0479401885F164E4E7B9678AB0C1
      Function="/Script/Engine.MaterialFunction'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput'"
      Desc="在有ID Map或顶点色输入的情况下指定脸或头发的ID, 适用于脸和头发使用同一个材质的情况.\r\n\r\n如果要使用发影(头发在脸上的投影)功能, 则必须正确设置脸和头发的ID.\r\n\r\n\r\nSpecifying the ID of the face or hair with ID Map or vertex color input, suitable for face and hair using the same material.\r\n\r\nIf you want to use the hair shadow (shadows of hair on the face) feature, the face and hair IDs must be set correctly."
   End Object
   Begin Object Name="MaterialExpressionScalarParameter_27" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_27'"
      DefaultValue=250.000000
