   Begin Object Name="MaterialExpressionScalarParameter_16" ExportPath="/Script/Engine.MaterialExpressionScalarParameter'/Game/EnvSandbox/Materials/Functions/MF_MooaToonBaseInput_2.MF_MooaToonBaseInput:MaterialExpressionScalarParameter_16'"
      DefaultValue=1.000000
