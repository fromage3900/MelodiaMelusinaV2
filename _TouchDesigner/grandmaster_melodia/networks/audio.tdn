- name: chord_detector_callbacks
  type: textDAT
  position: [550, -240]
  dock: chord_detector
  dat_content: "import numpy as np\nimport math\n\ndef onCook(scriptOp):\n    scriptOp.clear()\n    in_chop = scriptOp.inputs[0] if len(scriptOp.inputs) > 0 else None\n    \n    chord_root = 0.0\n    chord_quality = 0.0\n    \n    if in_chop and len(in_chop.chans()) > 0:\n        spec = np.array(in_chop[0].vals, dtype=np.float32)\n        n_bins = len(spec)\n        sample_rate = 44100.0\n        \n        if n_bins > 1:\n            freqs = np.linspace(20.0, sample_rate / 2.0, n_bins)\n            chroma = np.zeros(12, dtype=np.float32)\n            \n            valid_idx = np.where((freqs >= 65.0) & (freqs <= 2000.0))[0]\n            for idx in valid_idx:\n                mag = float(spec[idx])\n                if mag > 0.0001:\n                    f = float(freqs[idx])\n                    midi_note = 69.0 + 12.0 * math.log2(f / 440.0)\n                    p_class = int(round(midi_note)) % 12\n                    chroma[p_class] += mag * mag\n                    \n            chroma_sum = float(np.sum(chroma))\n            if chroma_sum > 1e-6:\n                chroma /= chroma_sum\n                \n                best_score = -1.0\n                best_root = 0\n                best_quality = 0\n                \n                for root in range(12):\n                    maj_score = chroma[root] + chroma[(root + 4) % 12] + chroma[(root + 7) % 12]\n                    if maj_score > best_score:\n                        best_score = maj_score\n                        best_root = root\n                        best_quality = 0\n                        \n                    min_score = chroma[root] + chroma[(root + 3) % 12] + chroma[(root + 7) % 12]\n                    if min_score > best_score:\n                        best_score = min_score\n                        best_root = root\n                        best_quality = 1\n                        \n                chord_root = float(best_root)\n                chord_quality = float(best_quality)\n                \n    c1 = scriptOp.appendChan(\"chan1\")\n    c2 = scriptOp.appendChan(\"chan2\")\n    c1[0] = float(chord_root)\n    c2[0] = float(chord_quality)\n\ndef onGetCookLevel(scriptOp):\n    return CookLevel.ALWAYS\n"
  dat_content_format: text
- name: pitch_analyzer_callbacks
  type: textDAT
  position: [0, -120]
  dock: pitch_analyzer
  dat_content: "import numpy as np\nimport math\n\ndef onCook(scriptOp):\n    scriptOp.clear()\n    in_chop = scriptOp.inputs[0] if len(scriptOp.inputs) > 0 else None\n    \n    freq = 0.0\n    note = 0.0\n    \n    if in_chop and len(in_chop.chans()) > 0:\n        arr0 = np.array(in_chop[0].vals, dtype=np.float32)\n        if len(in_chop.chans()) > 1:\n            arr1 = np.array(in_chop[1].vals, dtype=np.float32)\n            samples = 0.5 * (arr0 + arr1)\n        else:\n            samples = arr0\n            \n        rate = float(in_chop.rate) if hasattr(in_chop, 'rate') and in_chop.rate > 0 else 44100.0\n        n_samples = len(samples)\n        \n        rms = math.sqrt(float(np.mean(samples**2))) if n_samples > 0 else 0.0\n        \n        if n_samples >= 64 and rms > 0.005:\n            window = np.hanning(n_samples)\n            fft_mag = np.abs(np.fft.rfft(samples * window))\n            freqs = np.fft.rfftfreq(n_samples, d=1.0/rate)\n            \n            valid = (freqs >= 40.0) & (freqs <= 4000.0)\n            valid_indices = np.where(valid)[0]\n            \n            if len(valid_indices) > 0:\n                peak_sub_idx = np.argmax(fft_mag[valid_indices])\n                peak_idx = valid_indices[peak_sub_idx]\n                freq = float(freqs[peak_idx])\n                \n                if 0 < peak_idx < len(fft_mag) - 1:\n                    alpha = float(fft_mag[peak_idx - 1])\n                    beta = float(fft_mag[peak_idx])\n                    gamma = float(fft_mag[peak_idx + 1])\n                    denom = (alpha - 2.0 * beta + gamma)\n                    if abs(denom) > 1e-6:\n                        delta = 0.5 * (alpha - gamma) / denom\n                        bin_width = rate / float(n_samples)\n                        freq += delta * bin_width\n                        \n                freq = max(0.0, freq)\n                if freq >= 20.0:\n                    note = max(0.0, min(127.0, 69.0 + 12.0 * math.log2(freq / 440.0)))\n                    \n    c1 = scriptOp.appendChan(\"chan1\")\n    c2 = scriptOp.appendChan(\"chan2\")\n    c1[0] = float(freq)\n    c2[0] = float(note)\n\ndef onGetCookLevel(scriptOp):\n    return CookLevel.ALWAYS\n"
  dat_content_format: text
