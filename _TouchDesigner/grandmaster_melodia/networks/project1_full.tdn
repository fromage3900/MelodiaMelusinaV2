      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_content: "// Chromatic Aberration & Film Grain Pixel Shader\nuniform vec4 uChromaGrainParams; // x: chromaAmount, y: grainAmount, z: time\n\nout vec4 fragColor;\n\nfloat hash21(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nvoid main()\n{\n\tvec2 uv = vUV.st;\n\tvec2 center = vec2(0.5);\n\tvec2 dir = uv - center;\n\t\n\tfloat chromaAmt = uChromaGrainParams.x > 0.0 ? uChromaGrainParams.x : 0.006;\n\t\n\tvec2 uvR = center + dir * (1.0 + chromaAmt);\n\tvec2 uvG = uv;\n\tvec2 uvB = center + dir * (1.0 - chromaAmt);\n\t\n\tfloat r = texture(sTD2DInputs[0], clamp(uvR, 0.0, 1.0)).r;\n\tfloat g = texture(sTD2DInputs[0], clamp(uvG, 0.0, 1.0)).g;\n\tfloat b = texture(sTD2DInputs[0], clamp(uvB, 0.0, 1.0)).b;\n\tfloat a = texture(sTD2DInputs[0], uv).a;\n\t\n\tvec3 color = vec3(r, g, b);\n\t\n\tfloat grainAmt = uChromaGrainParams.y > 0.0 ? uChromaGrainParams.y : 0.04;\n\tfloat grainNoise = (hash21(uv * 1000.0 + vec2(uChromaGrainParams.z)) - 0.5) * grainAmt;\n\tcolor += vec3(grainNoise);\n\t\n\tfragColor = TDOutputSwizzle(vec4(color, a));\n}\n"
      dat_content_format: text
    - name: OUT_RENDER_REVIEW_postfx
      type: outTOP
      position: [329, -536]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - bokeh_blur
    - name: chroma_grain_pass_compute
      type: textDAT
      parameters:
        language: glsl
      flags:
      - viewer
      position: [1696, -772]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: chroma_grain_pass
    - name: anamorphic_streak_glsl_info
      type: infoDAT
      parameters:
        op: anamorphic_streak_glsl
      position: [2151, -772]
      dock: anamorphic_streak_glsl
      dat_read_only: true
    - name: anamorphic_streak_glsl_pixel
      type: textDAT
      parameters:
        language: glsl
        extension: frag
      flags:
      - viewer
      position: [1923, -772]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: anamorphic_streak_glsl
      dat_content: "// Anamorphic Bloom Streak Pixel Shader\nout vec4 fragColor;\nvoid main()\n{\n\tvec2 uv = vUV.st;\n\tvec4 sum = vec4(0.0);\n\tfloat weights[9] = float[](0.05, 0.09, 0.12, 0.15, 0.18, 0.15, 0.12, 0.09, 0.05);\n\tfloat dx = 0.003;\n\t\n\tfor (int i = -4; i <= 4; i++) {\n\t\tvec2 sampleUV = clamp(uv + vec2(float(i) * dx, 0.0), 0.0, 1.0);\n\t\tsum += texture(sTD2DInputs[0], sampleUV) * weights[i + 4];\n\t}\n\tfragColor = TDOutputSwizzle(sum * 1.3);\n}\n"
      dat_content_format: text
    - name: anamorphic_streak_glsl_compute
      type: textDAT
      parameters:
        language: glsl
      flags:
      - viewer
      position: [2151, -614]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: anamorphic_streak_glsl
