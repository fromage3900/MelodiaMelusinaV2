        - name: lower_3_tx
          type: transformSOP
          parameters:
            tx: 5
            ty: -1
          position: [750, -200]
          inputs:
          - lower_3
        - name: render_cam
          type: cameraCOMP
          parameters:
            tx: 6.53055
            ty: 3
            tz: 35
            lookat: /project1/worldgen/pieces/wg_belvedere/cam_target
            near: 0.0749362
            far: 144.962
            bgcolorr: 0.965
            bgcolorg: 0.945
            bgcolorb: 0.905
            bgcolora: 1
          position: [0, 400]
          children:
          - name: file1
