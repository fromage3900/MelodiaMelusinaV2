      - - '01:51:12       2 INFO    execute:10: Embody v6.0.126 | TouchDesigner 099.2025.32460 | Windows 11'
      - - '01:51:12       2 INFO    embody_admin:723: Restored 63 settings from config.json'
      - - '01:51:12       2 INFO    CatalogManagerExt: [CatalogManager] Loaded catalog for build 099.2025.32460'
