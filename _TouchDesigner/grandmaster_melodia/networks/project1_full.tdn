          - posx: -0.07
            posy: -0.07
            posz: -0.07
          - posx: -0.07
            posy: 0.07
            posz: 0.07
          - posx: 0.07
            posy: -0.07
            posz: -0.07
          - posx: 0.07
            posy: 0.07
            posz: -0.07
          - posx: -0.07
            posy: -0.07
            posz: 0.07
          - posx: -0.07
            posy: 0.07
            posz: -0.07
          - posx: 0.07
            posy: -0.07
            posz: 0.07
