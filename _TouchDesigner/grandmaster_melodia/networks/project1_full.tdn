              bgcolorb: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorb + r * 0.1
              bgalpha: 1
              borderar: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorr + .2
              borderag: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorg + .2
              borderab: =[c/.5 for c in [.23, .4, .3, .6]][parent().par.value0 + 2*parent().panel.rollover] * parent().par.colorb + .2
              leftborder: bordera
              rightborder: bordera
              bottomborder: bordera
              topborder: bordera
              borderover: false
            flags:
            - viewer
            position: [74, 26]
            size: [113, 96]
          - name: parexec1
            type: parameterexecuteDAT
            parameters:
              op: ..
              pars: value0
              onpulse: false
              defaultreadencoding: cp1252
              loadonstart: true
            flags:
            - viewer
            position: [66, -83]
            size: [128, 66]
            dat_content: "# par - the Par object that has changed\n# prev - the previous value\n\ndef onValueChange(par, prev):\n\tif not parent().panel.select :\n\t\tparent().panel.state = par.eval()\n\treturn"
            dat_content_format: text
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              panels: =parent()
              panelvalue: state
              offtoon: false
              valuechange: true
              defaultreadencoding: cp1252
              loadonstart: true
            flags:
            - viewer
            position: [247, -81]
            size: [126, 62]
            dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
            dat_content_format: text
        - name: Spacefield_Gravity1
          type: sliderCOMP
          parameters:
            value0: 0.343434
            alignorder: 1
          position: [25, -25]
          children:
          - name: knob
            type: containerCOMP
            parameters:
              x: =(parent().par.zonel + [tdu.remap(parent().par.value0.eval(), parent().par.valuerange0l.eval(), parent().par.valuerange0h.eval(), 0., 1.), 0., tdu.remap(parent().par.value0.eval(), parent().par.valuerange0l.eval(), parent().par.valuerange0h.eval(), 0., 1.)][parent().par.slidertype] * (parent().par.zoner-parent().par.zonel)) * parent().width - [0., me.width/2][me.width<5]
              y: =(parent().par.zoneb + [0., tdu.remap(parent().par.value1.eval(), parent().par.valuerange1l.eval(), parent().par.valuerange1h.eval(), 0., 1.), tdu.remap(parent().par.value1.eval(), parent().par.valuerange1l.eval(), parent().par.valuerange1h.eval(), 0., 1.)][parent().par.slidertype] * (parent().par.zonet-parent().par.zoneb)) * parent().height - [0., me.height/2][me.height<5]
              w: =parent().width if parent().par.slidertype == 'sliderv' else  4
              h: =parent().height if parent().par.slidertype == 'slideru' else 4
              layer: 2
              clickthrough: true
              bgcolorr: =.2 * parent().par.colorr + .5
              bgcolorg: =.2 * parent().par.colorg + .5
              bgcolorb: =.2 * parent().par.colorb + .5
              bgalpha: 1
              borderover: false
            flags:
            - viewer
            position: [25, -225]
            size: [118, 113]
          - name: out1
            type: outCHOP
            flags:
            - viewer
            position: [200, -100]
            inputs:
            - par1
          - name: par1
            type: parameterCHOP
            parameters:
              parameters: ='value0 value1' if parent().par.slidertype == 'slideruv' else 'value0'
              renameto: v1 v2
            position: [0, -100]
          - name: text
            type: textCOMP
            parameters:
              text: =parent().par.label
              type: multiline
              legacyfontselection: true
              scaletofit: onlyshrink
              fontsize: 10
              fontcolorr: =.2 * parent().par.colorr + .5
              fontcolorg: =.2 * parent().par.colorg + .5
              fontcolorb: =.2 * parent().par.colorb + .5
              textpaddingl: 4
              textpaddingr: 4
              textpaddingb: 3
              textpaddingt: 3
              alignx: left
              hmode: fill
              vmode: fill
              clickthrough: true
              bgcolorr: =0.4 * parent().par.colorr
              bgcolorg: =0.4 * parent().par.colorg
              bgcolorb: =0.4 * parent().par.colorb
              bgalpha: 1
              borderar: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorr + 0.2
              borderag: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorg + 0.2
              borderab: =[c/.5 for c in [.23, .4]][parent().panel.rollover] * parent().par.colorb + 0.2
              leftborder: bordera
              rightborder: bordera
              bottomborder: bordera
              topborder: bordera
              borderover: false
            flags:
            - viewer
            position: [175, -225]
            size: [160, 76]
          - name: panelexec1
            type: panelexecuteDAT
            parameters:
              panels: =parent()
              panelvalue: u v
              offtoon: false
              valuechange: true
              defaultreadencoding: cp1252
              loadonstart: true
            flags:
            - viewer
            position: [75, -325]
            size: [124, 51]
            dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue, prev):\n\tppar = parent().par\n\tppanel = parent().panel\n \n\tval0 = tdu.remap(panelValue.val, 0., 1., ppar.valuerange0l.eval(), ppar.valuerange0h.eval())\n\t\n\tif ppar.slidertype == 'slideru' and panelValue.name == 'u':\n\t\tppar.value0 = val0\n\telif ppar.slidertype == 'sliderv' and panelValue.name == 'v':\n\t\tppar.value0 = val0\n\telif ppar.slidertype == 'slideruv' :\n\t\tif panelValue.name == 'u':\n\t\t\tppar.value0 = val0\n\t\tif panelValue.name == 'v':\n\t\t\tppar.value1 =tdu.remap(panelValue.val, 0., 1., ppar.valuerange1l.eval(), ppar.valuerange1h.eval())\n\t\t\t\t\n\treturn"
            dat_content_format: text
    - name: PortfolioController
      type: textDAT
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_content: "class PortfolioController:\n    def __init__(self, ownerComp):\n        self.ownerComp = ownerComp\n        \n    def onInitTD(self):\n        # Force the perform window to reopen so it draws correctly\n        run(\"op('/perform').par.winopen = 0\", delayFrames=1)\n        run(\"op('/perform').par.winopen = 1\", delayFrames=3)\n\n    def UpdateSpacefield(self, val):\n        bloom = op('/project1/postfx/bloom_threshold')\n        if bloom:\n            bloom.par.brightness1 = 1.0 - val\n            \n    def UpdateBokeh(self, val):\n        blur = op('/project1/postfx/bloom_blur_30')\n        if blur:\n            blur.par.filtersize = val * 30\n"
      dat_content_format: text
