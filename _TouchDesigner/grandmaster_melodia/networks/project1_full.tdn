    - name: nikki_sanctuary_callbacks
      type: textDAT
      parameters:
        language: python
      flags:
      - viewer
      position: [-400, -160]
      size: [160, 130]
      color: [0.67, 0.67, 0.67]
      dock: nikki_sanctuary
      dat_content: "\"\"\"\nFBX COMP Callbacks\n\nme - this DAT\n\"\"\"\n\nfrom typing import List\n\ndef onImport(comp: fbxCOMP, allOps: List[OP], newOps: List[OP]):\n\t\"\"\"\n\tCalled when an FBX file is imported.\n\t\n\tArgs:\n\t\tcomp: The FBX COMP\n\t\tallOps: A list of all the OPs imported from the FBX file\n\t\tnewOps: The list of all OPs newly created from this import\n\t\"\"\"\n\n\tfor c in allOps:\n\t\t#if c.OPType == 'importselectSOP':\n\t\t#\tc.par.comptang = True\n\t\tpass\n\n\treturn\n"
      dat_content_format: text
  - name: worldgen
    type: baseCOMP
    position: [-685, 404]
    color: [0.1, 0.8, 0.1]
    comment: WORLDGEN â€” procedural Nikki x Escher world pieces. Rebuilt by scripts/worldgen/world_builder.py â€” do not hand-edit.
    children:
    - name: out1
      type: outTOP
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      comment: worldgen COMP output â€” wire me in /project1
      inputs:
      - master_out
    - name: camera
      type: cameraCOMP
      parameters:
        ty: 3
        tz: 35
      children:
      - name: file1
        type: fileinPOP
        flags:
        - display
        - viewer
      - name: wasd_controls
        type: baseCOMP
        color: [0.67, 0.67, 0.67]
        children:
        - name: keys
          type: keyboardinCHOP
          parameters:
            rate: =me.time.rate
            autoexportroot: =parent()
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: out1
          type: outCHOP
          color: [0.67, 0.67, 0.67]
          inputs:
          - speed
        - name: speed
          type: speedCHOP
          parameters:
            autoexportroot: =parent()
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
          inputs:
          - cam_velocity
        - name: cam_velocity
          type: constantCHOP
          sequences:
            const:
            - name: x
            - name: z
    - name: pieces
      type: baseCOMP
      position: [200, 0]
      color: [0.67, 0.67, 0.67]
      comment: 13 Escher pieces â€” one geometryCOMP each, rerun-safe
      children:
      - name: wg_belvedere
        type: geometryCOMP
        parameters:
          material: /project1/worldgen/materials/mat_ivory
        flags:
        - -display
        - -render
        position: [2400, 0]
        comment: Belvedere — upper and lower pillars that cannot both be true  [ivory]
        children:
        - name: lower_0
          type: tubeSOP
          position: [0, -200]
        - name: lower_1
          type: tubeSOP
          position: [200, -200]
        - name: lower_2
          type: tubeSOP
          position: [400, -200]
        - name: lower_3
          type: tubeSOP
          position: [600, -200]
        - name: upper_0
          type: tubeSOP
        - name: upper_1
          type: tubeSOP
          position: [200, 0]
        - name: upper_2
          type: tubeSOP
          position: [400, 0]
        - name: upper_3
          type: tubeSOP
          position: [600, 0]
        - name: floor_top
          type: boxSOP
          parameters:
            sizex: 10
            sizey: 0.2
            sizez: 3
          position: [900, 0]
        - name: cam_target
          type: nullCOMP
          parameters:
            tx: 0.615764
            ty: 0.00738915
          flags:
          - -display
          position: [200, 400]
          children:
          - name: primitive1
            type: primitivePOP
            parameters:
              method: pattern
            sequences:
              attr:
              - name: color
              prim:
              - type: lines
                pattern: 0 1
              - type: lines
                pattern: 2 3
              - type: lines
                pattern: 4 5
              pt:
              - posx: -0.1
                colorg: 0
                colorb: 0
              - posx: 0.1
                colorg: 0
                colorb: 0
              - posy: -0.1
                colorr: 0
                colorb: 0
              - posy: 0.1
                colorr: 0
                colorb: 0
              - posz: -0.1
                colorr: 0
                colorg: 0
              - posz: 0.1
                colorr: 0
                colorg: 0
            custom_pars:
              Points:
                $t: points
            flags:
            - display
            - viewer
        - name: lower_0_tx
          type: transformSOP
          parameters:
            tx: -2.5
            ty: -1
          position: [150, -200]
          inputs:
          - lower_0
        - name: lower_1_tx
          type: transformSOP
          parameters:
            ty: -1
          position: [350, -200]
          inputs:
