          - name: par1
            type: parameterCHOP
            parameters:
              parameters: ='value0 value1' if parent().par.slidertype == 'slideruv' else 'value0'
              renameto: v1 v2
            position: [0, -100]
          - name: text
            type: textCOMP
            parameters:
              text: =parent().par.label
