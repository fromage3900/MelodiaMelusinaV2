    - name: escher_penrose_stairs
      type: geometryCOMP
      flags:
      - -display
      - -render
      position: [-400, -800]
      comment: Penrose impossible stairs â€” 4 connected staircases forming a loop
      children:
      - name: step_0_0
        type: boxSOP
      - name: step_0_1
        type: boxSOP
        position: [0, -150]
