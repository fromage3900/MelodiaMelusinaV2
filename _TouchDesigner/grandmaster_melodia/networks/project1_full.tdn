    - name: renders
      type: baseCOMP
      position: [400, 0]
      color: [0.67, 0.67, 0.67]
      comment: renderTOPs + piece_switch + out1 â€” flat, same network
      children:
      - name: out1
        type: outTOP
        position: [1800, -200]
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
        comment: renders COMP output â€” appears on the renders node in worldgen
        inputs:
        - piece_switch
      - name: piece_switch
        type: switchTOP
        position: [1600, -200]
        comment: Index 0-12 = which piece renders out
        inputs:
        - render_penrose_stairs
        - render_spiral_staircase
        - render_fractal_tower
        - render_tessellation
        - render_belvedere
        - render_waterfall
        - render_infinite_library
        - render_relativity
        - render_ascending_descending
        - render_infinite_corridor
        - render_impossible_cube
        - render_stair_well
        - render_mobius_architecture
      - name: render_belvedere
