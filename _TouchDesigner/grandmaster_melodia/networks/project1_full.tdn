  - name: MelodiaStudioCore
    type: textDAT
    position: [1655, 191]
    size: [130, 90]
    color: [0.67, 0.67, 0.67]
    dat_content: "class MelodiaStudioCore:\n    def __init__(self, ownerComp):\n        self.ownerComp = ownerComp\n        print(\"MelodiaStudioCore Initialized\")\n\n    def UpdateBokeh(self, val):\n        print(f\"UpdateBokeh: {val}\")\n        postfx = self.ownerComp.op('postfx')\n        if postfx and postfx.op('bokeh_blur'):\n            postfx.op('bokeh_blur').par.filterwidth = val * 10\n            \n    def UpdateBubbles(self, val):\n        print(f\"UpdateBubbles: {val}\")\n        # To be implemented\n        \n    def UpdateAudio(self, val):\n        print(f\"UpdateAudio: {val}\")\n        # To be implemented\n"
    dat_content_format: text
