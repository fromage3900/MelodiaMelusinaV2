    - name: toon_satin_mat
      type: glslMAT
      parameters:
        vdat: /project1/shaders/toon_satin_vertex
        pdat: /project1/shaders/toon_satin_pixel
      sequences:
        mattr:
        - comps: 2
          cols: 2
        vec:
        - name: uCameraPos
          valuex: 0
          valuey: 0
          valuez: 4.2
        - name: uLightPos
          valuex: 3.5
          valuey: 4
          valuez: 5
        - name: uBaseColor
          valuex: 0.85
          valuey: 0.45
          valuez: 0.65
        - name: uToonColor
          valuey: 0.9
          valuez: 0.8
        - name: uShadowColor
          valuex: 0.2
          valuey: 0.15
          valuez: 0.35
        - name: uRimColor
          valuey: 0.8
          valuez: 0.5
        - name: uSheenColor
          valuey: 0.95
        - name: uParams
          valuex: 2.5
          valuey: 3
          valuez: 0
          valuew: 3
      position: [0, 300]
    - name: toon_satin_pixel
      type: textDAT
      position: [150, 450]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_content: "// Substrate Toon/Satin Pixel Shader\nin Vertex {\n    vec4 color;\n    vec3 worldPos;\n    vec3 worldNormal;\n    vec2 texCoord0;\n} iVert;\n\nuniform vec4 uCameraPos;       // xyz: Camera World Position\nuniform vec4 uLightPos;        // xyz: Key Light World Position\nuniform vec4 uBaseColor;\nuniform vec4 uToonColor;\nuniform vec4 uShadowColor;\nuniform vec4 uRimColor;\nuniform vec4 uSheenColor;\nuniform vec4 uParams; // x: rimExponent, y: sheenPower, z: audioPulse, w: toonBands\n\nout vec4 oFragColor;\n\nvoid main()\n{\n\tTDCheckDiscard();\n\t\n\tvec3 N = normalize(iVert.worldNormal);\n\tvec3 V = normalize(uCameraPos.xyz - iVert.worldPos);\n\tvec3 L = normalize(uLightPos.xyz - iVert.worldPos);\n\t\n\tfloat NdotL = max(0.0, dot(N, L));\n\tfloat NdotV = max(0.0, dot(N, V));\n\t\n\t// Toon Diffuse Banding (3-step Cel Ramp)\n\tfloat toonBands = uParams.w > 0.0 ? uParams.w : 3.0;\n\tfloat toonStep = floor(NdotL * toonBands) / (toonBands - 1.0);\n\ttoonStep = clamp(toonStep, 0.0, 1.0);\n\t\n\tvec3 diffuse = mix(uShadowColor.rgb, uBaseColor.rgb * uToonColor.rgb, toonStep);\n\t\n\t// Satin Specular Sheen (Soft anisotropic edge sheen)\n\tfloat sheenPower = uParams.y > 0.0 ? uParams.y : 3.0;\n\tfloat sheen = pow(1.0 - NdotV, sheenPower);\n\tvec3 satinSheen = sheen * uSheenColor.rgb * (1.0 + uParams.z * 0.5);\n\t\n\t// Warm Rim Light\n\tfloat rimExp = uParams.x > 0.0 ? uParams.x : 2.5;\n\tfloat rim = pow(1.0 - NdotV, rimExp) * max(0.2, NdotL + 0.3);\n\tvec3 rimGlow = rim * uRimColor.rgb * (1.0 + uParams.z * 0.8);\n\t\n\tvec3 finalRGB = diffuse + satinSheen + rimGlow;\n\t\n\tvec4 color = vec4(finalRGB, uBaseColor.a);\n\tTDAlphaTest(color.a);\n\toFragColor = TDOutputSwizzle(color);\n}\n"
      dat_content_format: text
    - name: toon_satin_vertex
      type: textDAT
      position: [0, 450]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_content: "// Substrate Toon/Satin Vertex Shader\nout Vertex {\n    vec4 color;\n    vec3 worldPos;\n    vec3 worldNormal;\n    vec2 texCoord0;\n} oVert;\n\nvoid main() \n{\n\tvec3 pos = TDPos();\n\tvec4 worldSpacePos = TDDeform(pos);\n\toVert.worldPos = worldSpacePos.xyz;\n\toVert.worldNormal = normalize(TDDeformNorm(TDNormal()).xyz);\n\toVert.texCoord0 = TDTexCoord(0).xy;\n\tgl_Position = TDWorldToProj(worldSpacePos);\n#ifndef TD_PICKING_ACTIVE\n#else\n\tTDWritePickingValues();\n#endif\n}\n"
      dat_content_format: text
    - name: toon_satin_mat_info
      type: infoDAT
      parameters:
        op: toon_satin_mat
      position: [320, -120]
      dock: toon_satin_mat
      dat_read_only: true
    - name: toon_satin_mat_pixel
      type: textDAT
      parameters:
        language: glsl
        extension: frag
      flags:
      - viewer
      position: [160, -120]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: toon_satin_mat
      dat_content: "// Example Pixel Shader\n\n// uniform vec4 exampleUniform;\n\nout vec4 oFragColor;\nvoid main()\n{\n\tTDCheckDiscard();\n\tvec4 color = vec4(1.0);\n\tTDAlphaTest(color.a);\n\toFragColor = TDOutputSwizzle(color);\n}\n\n"
      dat_content_format: text
    - name: toon_satin_mat_vertex
      type: textDAT
      parameters:
        language: glsl
        extension: vert
      flags:
      - viewer
      position: [0, -120]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: toon_satin_mat
      dat_content: "// Example Vertex Shader\n\nvoid main() \n{\n\tvec3 pos = TDPos();\n\tvec4 worldSpacePos = TDDeform(pos);\n\tgl_Position = TDWorldToProj(worldSpacePos);\n#ifndef TD_PICKING_ACTIVE\n#else // TD_PICKING_ACTIVE\n\t// This will automatically write out the nessessary values\n\t// for this shader to work with picking.\n\t// See the documentation if you want to write custom values for picking.\n\tTDWritePickingValues();\n#endif // TD_PICKING_ACTIVE\n}\n\n"
      dat_content_format: text
    - name: iridescent_crystal_mat
      type: glslMAT
      parameters:
        vdat: /project1/shaders/iridescent_crystal_vertex
        pdat: /project1/shaders/iridescent_crystal_pixel
      sequences:
        mattr:
        - comps: 2
          cols: 2
        vec:
        - name: uCameraPos
          valuex: 0
          valuey: 0
          valuez: 4.2
        - name: uLightPos
          valuex: 3.5
          valuey: 4
          valuez: 5
        - name: uCrystalBase
          valuex: 0.7
          valuey: 0.9
          valuew: 0.85
        - name: uDispersionParams
          valuex: 2.5
          valuey: 3
          valuez: 0.5
          valuew: 6
        - name: uAudioParams
          valuex: 0
          valuey: 0
      position: [400, 300]
    - name: iridescent_crystal_pixel
      type: textDAT
      position: [550, 450]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_content: "// Iridescent Crystal Pixel Shader\nin Vertex {\n    vec4 color;\n    vec3 worldPos;\n    vec3 worldNormal;\n    vec2 texCoord0;\n} iVert;\n\nuniform vec4 uCameraPos;       // xyz: Camera World Position\nuniform vec4 uLightPos;        // xyz: Key Light World Position\nuniform vec4 uCrystalBase;     // Base crystal tint\nuniform vec4 uDispersionParams; // x: iridFreq, y: fresnelPow, z: refraction, w: noiseScale\nuniform vec4 uAudioParams;      // x: audioPulse, y: time\n\nout vec4 oFragColor;\n\nfloat hash(vec3 p) {\n    p = fract(p * vec3(443.897, 441.423, 437.195));\n    p += dot(p, p.yxz + 19.19);\n    return fract((p.x + p.y) * p.z);\n}\n\nvec3 spectralPalette(float t) {\n    // Cyan -> Magenta -> Gold Triad Palette\n    vec3 a = vec3(0.5, 0.5, 0.5);\n    vec3 b = vec3(0.5, 0.5, 0.5);\n    vec3 c = vec3(1.0, 1.0, 1.0);\n    vec3 d = vec3(0.0, 0.33, 0.67);\n    return a + b * cos(6.28318 * (c * t + d));\n}\n\nvoid main()\n{\n\tTDCheckDiscard();\n\t\n\tvec3 N = normalize(iVert.worldNormal);\n\tvec3 V = normalize(uCameraPos.xyz - iVert.worldPos);\n\tvec3 L = normalize(uLightPos.xyz - iVert.worldPos);\n\t\n\tfloat noiseScale = uDispersionParams.w > 0.0 ? uDispersionParams.w : 5.0;\n\tfloat nVal = hash(floor(iVert.worldPos * noiseScale));\n\tN = normalize(N + (vec3(nVal) - 0.5) * 0.15);\n\t\n\tfloat NdotV = max(0.0, dot(N, V));\n\tfloat NdotL = max(0.0, dot(N, L));\n\t\n\tfloat fresnelPow = uDispersionParams.y > 0.0 ? uDispersionParams.y : 3.0;\n\tfloat fresnel = pow(1.0 - NdotV, fresnelPow);\n\t\n\tfloat iridFreq = uDispersionParams.x > 0.0 ? uDispersionParams.x : 2.5;\n\tfloat t = NdotV * iridFreq + uAudioParams.y * 0.1 + uAudioParams.x * 0.2;\n\tvec3 iridColor = spectralPalette(t);\n\t\n\tvec3 H = normalize(L + V);\n\tfloat NdotH = max(0.0, dot(N, H));\n\tfloat spec = pow(NdotH, 64.0);\n\tvec3 specular = vec3(spec * 1.5);\n\t\n\tvec3 refColor = mix(uCrystalBase.rgb, iridColor, fresnel);\n\tvec3 finalColor = refColor * (0.4 + 0.6 * NdotL) + specular + iridColor * fresnel * 0.8;\n\t\n\tvec4 color = vec4(finalColor, clamp(uCrystalBase.a + fresnel * 0.3, 0.0, 1.0));\n\tTDAlphaTest(color.a);\n\toFragColor = TDOutputSwizzle(color);\n}\n"
      dat_content_format: text
    - name: OUT_RENDER_REVIEW_shaders
      type: outTOP
      position: [600, -100]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      inputs:
      - null_shaders
    - name: iridescent_crystal_vertex
      type: textDAT
      position: [400, 450]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dat_content: "// Iridescent Crystal Vertex Shader\nout Vertex {\n    vec4 color;\n    vec3 worldPos;\n    vec3 worldNormal;\n    vec2 texCoord0;\n} oVert;\n\nvoid main() \n{\n\tvec3 pos = TDPos();\n\tvec4 worldSpacePos = TDDeform(pos);\n\toVert.worldPos = worldSpacePos.xyz;\n\toVert.worldNormal = normalize(TDDeformNorm(TDNormal()).xyz);\n\toVert.texCoord0 = TDTexCoord(0).xy;\n\tgl_Position = TDWorldToProj(worldSpacePos);\n#ifndef TD_PICKING_ACTIVE\n#else\n\tTDWritePickingValues();\n#endif\n}\n"
      dat_content_format: text
    - name: iridescent_crystal_mat_info
      type: infoDAT
      parameters:
        op: iridescent_crystal_mat
      position: [320, -120]
      dock: iridescent_crystal_mat
      dat_read_only: true
    - name: iridescent_crystal_mat_pixel
      type: textDAT
      parameters:
        language: glsl
        extension: frag
      flags:
      - viewer
      position: [160, -120]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: iridescent_crystal_mat
      dat_content: "// Example Pixel Shader\n\n// uniform vec4 exampleUniform;\n\nout vec4 oFragColor;\nvoid main()\n{\n\tTDCheckDiscard();\n\tvec4 color = vec4(1.0);\n\tTDAlphaTest(color.a);\n\toFragColor = TDOutputSwizzle(color);\n}\n\n"
      dat_content_format: text
    - name: iridescent_crystal_mat_vertex
      type: textDAT
      parameters:
        language: glsl
        extension: vert
      flags:
      - viewer
      position: [0, -120]
      size: [130, 90]
      color: [0.67, 0.67, 0.67]
      dock: iridescent_crystal_mat
      dat_content: "// Example Vertex Shader\n\nvoid main() \n{\n\tvec3 pos = TDPos();\n\tvec4 worldSpacePos = TDDeform(pos);\n\tgl_Position = TDWorldToProj(worldSpacePos);\n#ifndef TD_PICKING_ACTIVE\n#else // TD_PICKING_ACTIVE\n\t// This will automatically write out the nessessary values\n\t// for this shader to work with picking.\n\t// See the documentation if you want to write custom values for picking.\n\tTDWritePickingValues();\n#endif // TD_PICKING_ACTIVE\n}\n\n"
      dat_content_format: text
  - name: learn_td
    type: baseCOMP
    position: [714, -342]
    color: [0.6, 0.6, 0.6]
    comment: LEARN TD — Tutorial + Escher geometry playground (5 pieces)
    children:
    - name: my_playground
      type: geometryCOMP
      flags:
      - -display
      - -render
      position: [600, 0]
      comment: Your sandbox — right-click to add SOPs
      children:
      - name: starter
        type: boxSOP
      - name: render_cam
        type: cameraCOMP
        parameters:
          tx: 5
          ty: 3
          tz: 35
        position: [150, 200]
        children:
        - name: file1
          type: fileinPOP
          flags:
          - display
          - viewer
      - name: render_out
        type: renderTOP
        parameters:
          camera: /project1/learn_td/my_playground/render_cam
        position: [200, 0]
        comment: Renders this geometry â€” connected to master switch
    - name: instanced_city
      type: geometryCOMP
      flags:
      - -display
      - -render
      position: [200, -400]
      children:
      - name: tower
        type: tubeSOP
      - name: city_grid
        type: gridSOP
        position: [0, -200]
      - name: render_cam
        type: cameraCOMP
        parameters:
          tx: 5
          ty: 3
          tz: 35
        position: [150, 200]
        children:
        - name: file1
          type: fileinPOP
          flags:
          - display
          - viewer
      - name: render_out
        type: renderTOP
        parameters:
          camera: /project1/learn_td/instanced_city/render_cam
        position: [200, 0]
        comment: Renders this geometry â€” connected to master switch
      - name: copy_towers
        type: copySOP
        position: [400, 0]
        inputs:
        - tower
        - city_grid
    - name: nikki_sanctuary
      type: fbxCOMP
      parameters:
        file: =app.samplesFolder+'/FBX/TDLogo.fbx'
        callbacks: nikki_sanctuary_callbacks
        index: =me.time.frame
      flags:
      - -display
      - -render
      position: [-400, 0]
      size: [160, 130]
      color: [0.67, 0.67, 0.67]
      comment: Double-click to enter. Set FBX file path in parameters.
      children:
      - name: file1
        type: nullCOMP
        flags:
        - -display
        - viewer
        position: [629, 0]
        children:
        - name: primitive1
          type: primitivePOP
          parameters:
            method: pattern
          sequences:
            attr:
            - name: color
            prim:
            - type: lines
              pattern: 0 1
            - type: lines
              pattern: 2 3
            - type: lines
              pattern: 4 5
            pt:
            - posx: -0.1
              colorg: 0
              colorb: 0
            - posx: 0.1
              colorg: 0
              colorb: 0
            - posy: -0.1
              colorr: 0
              colorb: 0
            - posy: 0.1
              colorr: 0
              colorb: 0
            - posz: -0.1
              colorr: 0
              colorg: 0
            - posz: 0.1
              colorr: 0
              colorg: 0
          custom_pars:
            Points:
              $t: points
          flags:
          - display
          - viewer
      - name: group1
        type: geometryCOMP
        parameters:
          ty: 0.7
          material: ./a
        flags:
        - -display
        - -render
        - viewer
        position: [909, 0]
        children:
        - name: a
          type: phongMAT
          parameters:
            ambdiff: false
            diffr: 0.756863
            diffg: 0.756863
            diffb: 0.756863
            ambr: 0
            ambg: 0
            ambb: 0
            specr: 0
            specg: 0
            specb: 0
            postmultalpha: false
          flags:
          - viewer
          position: [100, 0]
        - name: mesh
          type: importselectPOP
          parameters:
            geometry: /group1
            index: =me.time.frame
          flags:
          - display
          - render
          - viewer
          position: [327, 0]
          size: [130, 90]
          color: [0.67, 0.67, 0.67]
        - name: touchMergedNodes
          type: tableDAT
          flags:
          - viewer
          position: [554, 0]
          color: [0.67, 0.67, 0.67]
          dat_content:
          - - original_path
          - - group1
          - - group27
          - - group26
          - - group25
          - - group24
          - - group23
          - - group22
