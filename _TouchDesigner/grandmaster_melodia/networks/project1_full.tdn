            - type: lines
              pattern: 0 1
            - type: lines
              pattern: 2 3
            - type: lines
              pattern: 4 5
            pt:
            - posx: -0.1
              colorg: 0
              colorb: 0
            - posx: 0.1
              colorg: 0
              colorb: 0
            - posy: -0.1
              colorr: 0
              colorb: 0
            - posy: 0.1
              colorr: 0
