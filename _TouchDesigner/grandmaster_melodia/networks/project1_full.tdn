          dat_content: "# panelValue - the PanelValue object that changed\n# Make sure the corresponding toggle is enabled in the Panel Execute DAT.\n\ndef onValueChange(panelValue):\n\tparent().par.value0 = panelValue\n\treturn"
          dat_content_format: text
      - name: replicator1_callbacks
        type: textDAT
        parameters:
          language: python
        flags:
        - viewer
        position: [-225, -160]
        size: [160, 130]
        color: [0.9, 0.3, 0.4]
        dock: replicator1
        dat_content: "# me - this DAT\n# \n# comp - the replicator component which is cooking\n# allOps - a list of all replicants, created or existing\n# newOps - the subset that were just created\n# template - table DAT specifying the replicator attributes\n# master - the master operator\n#\n\ndef onRemoveReplicant(comp, replicant):\n\n\treplicant.destroy()\n\treturn\n\ndef onReplicate(comp, allOps, newOps, template, master):\n\n\tfor c in newOps:\n\t\t#c.display = True\n\t\t#c.render = True\n\t\tc.par.display = 1\n\t\t#c.par.clone = comp.par.master\n\t\tpass\n\n\treturn\n"
        dat_content_format: text
    - name: timer1
      type: timerCHOP
      parameters:
        active: never
        deferpars: true
        length: 30
        lengthunits: frames
        delayunits: samples
        maxcycles: 2
        callbacks: timer_callbacks
        outfraction: false
        outready: false
        outdone: false
        exttcop: =tdu.Timecode()
        rate: =me.time.rate
        autoexportroot: =parent()
      position: [-700, -275]
      size: [130, 90]
    - name: wizard
      type: containerCOMP
      parameters:
        w: 500
        h: 440
        bgcolorr: 0.11
        bgcolorg: 0.12
        bgcolorb: 0.115
        bgalpha: 1
        align: verttb
        spacing: 10
      position: [1200, 225]
      size: [160, 130]
      color: [0.3, 0.5, 0.9]
      storage:
        step: 0
        sel:
          mode: advanced
        step_id: summary
        sel_mode: auto
        sel_assistant: other
        sel_client: cursor
        sel_root: gitroot
        sel_permissions: all
      children:
      - name: hint
        type: textCOMP
        parameters:
          text: |-
            Mode: auto. AI assistant: on (cursor).
            Nothing has changed yet - click Set up Embody to apply.
          type: multiline
          wordwrap: true
          callbacks: hint_callbacks
          fontsize: 11
          fontcolorr: 0.6
          fontcolorg: 0.61
          fontcolorb: 0.6
          textoffsetx: 24
          textpaddingr: 20
          alignx: left
          aligny: top
          w: 452
          h: 60
          alignorder: 3
          clickthrough: true
          bgcolorr: 0.11
          bgcolorg: 0.12
          bgcolorb: 0.115
          bgalpha: 1
        size: [160, 130]
        color: [0.67, 0.67, 0.67]
      - name: logic
        type: textDAT
        parameters:
          language: python
        position: [240, 0]
        size: [130, 90]
        color: [0.9, 0.3, 0.4]
        dat_content: "SURF=(0.16,0.17,0.165)\nBACK_ON=(0.19,0.20,0.195); NEXT_ON=(0.24,0.52,0.35); NEXT_OFF=(0.135,0.15,0.14)\nTXT=(0.92,0.92,0.92); TXT_DIM=(0.34,0.35,0.34); NEXT_TXT=(0.97,0.99,0.97)\nGROUPS=['grp_mode','grp_assistant','grp_client','grp_permissions','grp_footprint']\nDEFS={\n 'mode':{'g':'grp_mode','sel':'sel_mode','title':'How should Embody manage your project?','hint':'Choose one, then Next.'},\n 'assistant':{'g':'grp_assistant','sel':'sel_assistant','title':'Turn on the AI assistant (Envoy)?','hint':'It lets AI tools work in your network. Easy to remove later.'},\n 'client':{'g':'grp_client','sel':'sel_client','title':'Pick your AI coding tool','hint':'Embody will generate its config.'},\n 'footprint':{'g':'grp_footprint','sel':'sel_root','title':'Review what Embody will add','hint':'Embody will add a Python env (.venv) + MCP server, config files (.mcp.json, .embody, AI rules), .gitignore/.gitattributes entries + a .tdn diff driver, and the Embot assistant in your network. Everything is recorded and reversible via Uninstall.'},\n 'permissions':{'g':'grp_permissions','sel':'sel_permissions','title':'How should the AI ask permission?','hint':'Claude Code asks before each AI tool by default. Pick how much to auto-approve (changeable later on the Envoy parameters).'},\n 'summary':{'g':None,'sel':None,'title':'Ready to set up Embody','hint':''},\n}\ndef _w(): return parent()\ndef _bg(o,c):\n\tif o:\n\t\tfor i,ch in enumerate('rgb'): setattr(o.par,'bgcolor'+ch,c[i])\ndef _tc(o,c):\n\tif not o: return\n\tfor pref in ('fontcolorr','textcolorr'):\n\t\tif hasattr(o.par,pref):\n\t\t\tb=pref[:-1]\n\t\t\tfor i,ch in enumerate('rgb'): setattr(o.par,b+ch,c[i])\n\t\t\treturn\ndef spine():\n\tw=_w(); m=w.fetch('sel_mode',None); a=w.fetch('sel_assistant',None)\n\ts=['mode','assistant']\n\tif a=='other': s.append('client')\n\tif a=='claudecode': s.append('permissions')\n\tif m=='advanced' and a not in (None,'none'): s.append('footprint')\n\ts.append('summary'); return s\ndef _grp(step): return _w().op(DEFS.get(step,{}).get('g') or '')\ndef _chosen(step):\n\tg=_grp(step)\n\tif not g: return None\n\tfor c in g.children:\n\t\tif c.family=='COMP' and hasattr(c.par,'value0') and c.par.value0.eval(): return c.name.replace('opt_','')\n\treturn None\ndef _nav(k):\n\tfor c in _w().op('footer').children:\n\t\tif c.family=='COMP' and k in c.name: return c\ndef _recap():\n\tw=_w(); m=w.fetch('sel_mode','auto'); a=w.fetch('sel_assistant','claudecode')\n\tif a=='none': return 'Mode: %s. AI assistant: off (externalization only).\\nNothing has changed yet - click Set up Embody to apply.'%m\n\tc=w.fetch('sel_client','') if a=='other' else ('Claude Code' if a=='claudecode' else a)\n\treturn 'Mode: %s. AI assistant: on (%s).\\nNothing has changed yet - click Set up Embody to apply.'%(m, c or 'your tool')\ndef _permHint():\n\tbase=DEFS['permissions']['hint']\n\ttry:\n\t\tfrom pathlib import Path\n\t\troot=op.Embody.ext.Embody._findProjectRoot()\n\t\tif root and (Path(str(root))/'.claude'/'settings.local.json').exists():\n\t\t\tbase+='\\nA settings.local.json already exists -- Embody edits only its Envoy entries, keeping the rest.'\n\texcept Exception: pass\n\treturn base\ndef render():\n\tw=_w(); sp=spine(); cur=w.fetch('step_id','mode')\n\tif cur not in sp: cur='mode'; w.store('step_id',cur)\n\tidx=sp.index(cur); d=DEFS[cur]\n\tw.op('steplabel').par.text='Step %d of %d'%(idx+1,len(sp))\n\tw.op('track/fill').par.w=int(452*(idx+1)/len(sp))\n\tfor gid in GROUPS:\n\t\tg=w.op(gid)\n\t\tif g: g.par.display = 1 if gid==d.get('g') else 0\n\tw.op('title').par.text=d['title']\n\tw.op('hint').par.text=_permHint() if cur=='permissions' else (_recap() if cur=='summary' else d['hint'])\n\tw.op('hint').par.h = 60 if cur in ('footprint','summary','permissions') else 16\n\tbb=_nav('back'); nb=_nav('next'); first=idx==0\n\tif bb:\n\t\tif bb.op('text'): bb.op('text').par.text='Not now' if first else 'Back'\n\t\t_bg(bb, BACK_ON); _tc(bb.op('text'), TXT_DIM if first else TXT)\n\tlast=cur=='summary'; ok=last or (d.get('g') is None) or (_chosen(cur) is not None)\n\tif
          nb:\n\t\tif nb.op('text'): nb.op('text').par.text='Set up Embody' if last else 'Next'\n\t\t_bg(nb, NEXT_ON if ok else NEXT_OFF); _tc(nb.op('text'), NEXT_TXT if ok else TXT_DIM)\ndef click(name):\n\tw=_w(); sp=spine(); cur=w.fetch('step_id','mode')\n\tif name.startswith('btn_') or 'back' in name or 'next' in name:\n\t\tif 'back' in name:\n\t\t\tidx=sp.index(cur) if cur in sp else 0\n\t\t\tif idx>0: w.store('step_id', sp[idx-1]); render()\n\t\t\telse: _close()\n\t\telif 'next' in name:\n\t\t\td=DEFS[cur]\n\t\t\tif d.get('g') and cur!='summary' and _chosen(cur) is None: return\n\t\t\tidx=sp.index(cur) if cur in sp else 0\n\t\t\tif cur=='summary': finish()\n\t\t\telif idx<len(sp)-1: w.store('step_id', sp[idx+1]); render()\n\t\treturn\n\td=DEFS[cur]; g=_grp(cur)\n\tif g:\n\t\tfor c in g.children:\n\t\t\tif c.family=='COMP' and hasattr(c.par,'value0'): c.par.value0 = 1 if c.name==name else 0\n\tif d.get('sel'): w.store(d['sel'], name.replace('opt_',''))\n\trender()\ndef _close():\n\ttry: op.Embody.op('window_wizard').par.winclose.pulse()\n\texcept Exception: pass\ndef finish():\n\tw=_w()\n\tm=w.fetch('sel_mode','auto'); a=w.fetch('sel_assistant','claudecode')\n\tc=w.fetch('sel_client',''); r=w.fetch('sel_root','gitroot')\n\tpm=w.fetch('sel_permissions','all')\n\tcr=''\n\tif r=='custom':\n\t\ttry: cr=ui.chooseFolder(title='Choose the folder for Embody config') or ''\n\t\texcept Exception: cr=''\n\t_close()\n\t# Defer so the window closes cleanly before setup runs. Tokens come from the\n\t# wizard's fixed option set, so repr-interpolation is safe.\n\trun('op.Embody.ext.Embody._applyWizardSetup(mode=%r, assistant=%r, client=%r, root=%r, custom_root=%r, permissions=%r)'%(m,a,c,r,cr,pm), delayFrames=2)\ndef start():\n\tw=_w(); w.store('step_id','mode')\n\tfor gid in GROUPS:\n\t\tg=w.op(gid)\n\t\tif g:\n\t\t\tfor c in g.children:\n\t\t\t\tif c.family=='COMP' and hasattr(c.par,'value0'): c.par.value0=0\n\tmd=op.Embody.par.Embodymode.eval()\n\tmb=w.op('grp_mode/opt_'+md)\n\tif mb: mb.par.value0=1\n\tw.store('sel_mode',md)\n\tab=w.op('grp_assistant/opt_claudecode')\n\tif ab: ab.par.value0=1\n\tpb=w.op('grp_permissions/opt_all')\n\tif pb: pb.par.value0=1\n\tw.store('sel_assistant','claudecode'); w.store('sel_client',''); w.store('sel_root','gitroot'); w.store('sel_permissions','all')\n\trender()\n"
        dat_content_format: text
      - name: title
        type: textCOMP
        parameters:
          text: Ready to set up Embody
          wordwrap: true
          callbacks: title_callbacks
          fontsize: 18
          fontcolorr: 0.92
          fontcolorg: 0.92
          fontcolorb: 0.92
          textoffsetx: 24
          alignx: left
          h: 30
          hmode: fill
          alignorder: 2
          clickthrough: true
          bgcolorr: 0.11
          bgcolorg: 0.12
          bgcolorb: 0.115
          bgalpha: 1
        position: [480, 0]
        size: [160, 130]
        color: [0.67, 0.67, 0.67]
      - name: track
        type: containerCOMP
        parameters:
          h: 4
          hmode: fill
          alignorder: 1
          bgcolorr: 0.2
          bgcolorg: 0.21
          bgcolorb: 0.205
          bgalpha: 1
          marginl: 24
          marginr: 24
        position: [0, -150]
        size: [160, 130]
        color: [0.67, 0.67, 0.67]
        children:
        - name: fill
          type: containerCOMP
          parameters:
            w: 452
            h: 4
            bgcolorr: 0.24
            bgcolorg: 0.52
            bgcolorb: 0.35
            bgalpha: 1
          size: [160, 130]
          color: [0.67, 0.67, 0.67]
      - name: clicks
        type: panelexecuteDAT
        parameters:
          panels: footer/btn_* grp_mode/opt_* grp_assistant/opt_* grp_client/opt_* grp_permissions/opt_* grp_footprint/opt_*
          ontooff: true
        position: [240, -150]
        size: [130, 90]
        color: [0.9, 0.3, 0.4]
        dat_content: "def onOffToOn(panelValue):\n\top.Embody.op(\"wizard/logic\").module.click(panelValue.owner.name)\n\treturn\ndef onOnToOff(panelValue):\n\tn=panelValue.owner.name\n\tif n.startswith(\"opt_\"):\n\t\top.Embody.op(\"wizard/logic\").module.click(n)\n\treturn\n"
        dat_content_format: text
      - name: footer
        type: containerCOMP
        parameters:
          h: 40
          hmode: fill
          bottomanchor: 0.923
          alignorder: 5
          bgcolorr: 0.11
          bgcolorg: 0.12
          bgcolorb: 0.115
          bgalpha: 1
          align: horizlr
          spacing: 10
          marginl: 24
          marginr: 24
          margint: 4
        position: [250, -700]
        size: [160, 130]
        color: [0.67, 0.67, 0.67]
        children:
        - name: btn_back
          type: buttonCOMP
          parameters:
            buttontype: momentary
            h: 36
            hmode: fill
            bgcolorr: 0.19
            bgcolorg: 0.2
            bgcolorb: 0.195
            bgalpha: 1
          size: [160, 134]
          children:
          - name: out1
            type: outCHOP
            flags:
            - viewer
            position: [275, 175]
            inputs:
            - par1
          - name: par1
            type: parameterCHOP
            parameters:
              parameters: value0
              renameto: v1
            position: [65, 175]
          - name: text
            type: textCOMP
            parameters:
              text: Back
              type: multiline
              legacyfontselection: true
              scaletofit: =parent().par[me.curPar.name] or me.curPar.val
              fontsize: 13
              linespacing: =parent().par[me.curPar.name] or me.curPar.val
              fontcolorr: 0.92
              fontcolorg: 0.92
              fontcolorb: 0.92
              textpaddingl: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingr: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingb: =parent().par[me.curPar.name] or me.curPar.val
              textpaddingt: =parent().par[me.curPar.name] or me.curPar.val
              hmode: fill
              vmode: fill
              clickthrough: true
              bgcolorr: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorr + r * 0.1
              bgcolorg: =[c/.5 for c in [.2, .4, .15, .35]][parent().par.value0 + 2*(r:=parent().panel.rollover)] * parent().par.colorg + r * 0.1
