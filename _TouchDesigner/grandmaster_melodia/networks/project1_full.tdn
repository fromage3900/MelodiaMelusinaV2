      - name: fbx_info
        type: infoCHOP
        parameters:
          op: =parent.FBX
          childcooktime: true
          autoexportroot: =parent()
        flags:
        - viewer
        size: [130, 90]
        color: [0.67, 0.67, 0.67]
      - name: info_out
        type: outCHOP
        flags:
        - viewer
        position: [227, 0]
        color: [0.67, 0.67, 0.67]
        inputs:
        - fbx_info
