- name: chroma_grain_pass_pixel
  type: textDAT
  position: [1241, -772]
  dat_content: "// Chromatic Aberration & Film Grain Pixel Shader\nuniform vec4 uChromaGrainParams; // x: chromaAmount, y: grainAmount, z: time\n\nout vec4 fragColor;\n\nfloat hash21(vec2 p) {\n    p = fract(p * vec2(123.34, 456.21));\n    p += dot(p, p + 45.32);\n    return fract(p.x * p.y);\n}\n\nvoid main()\n{\n\tvec2 uv = vUV.st;\n\tvec2 center = vec2(0.5);\n\tvec2 dir = uv - center;\n\t\n\tfloat chromaAmt = uChromaGrainParams.x > 0.0 ? uChromaGrainParams.x : 0.006;\n\t\n\tvec2 uvR = center + dir * (1.0 + chromaAmt);\n\tvec2 uvG = uv;\n\tvec2 uvB = center + dir * (1.0 - chromaAmt);\n\t\n\tfloat r = texture(sTD2DInputs[0], clamp(uvR, 0.0, 1.0)).r;\n\tfloat g = texture(sTD2DInputs[0], clamp(uvG, 0.0, 1.0)).g;\n\tfloat b = texture(sTD2DInputs[0], clamp(uvB, 0.0, 1.0)).b;\n\tfloat a = texture(sTD2DInputs[0], uv).a;\n\t\n\tvec3 color = vec3(r, g, b);\n\t\n\tfloat grainAmt = uChromaGrainParams.y > 0.0 ? uChromaGrainParams.y : 0.04;\n\tfloat grainNoise = (hash21(uv * 1000.0 + vec2(uChromaGrainParams.z)) - 0.5) * grainAmt;\n\tcolor += vec3(grainNoise);\n\t\n\tfragColor = TDOutputSwizzle(vec4(color, a));\n}\n"
  dat_content_format: text
