- name: dof_pass_pixel
  type: textDAT
  position: [558, -772]
  dat_content: "// Depth Bokeh DoF Pass Pixel Shader\nuniform vec4 uDoFParams; // x: maxBlur, y: focusDist, z: focusRange\n\nout vec4 fragColor;\n\nvoid main()\n{\n\tvec2 uv = vUV.st;\n\tvec4 baseColor = texture(sTD2DInputs[0], uv);\n\t\n\tfloat distFromCenter = length(uv - vec2(0.5)) * 2.0;\n\tfloat focusDist = uDoFParams.y > 0.0 ? uDoFParams.y : 0.25;\n\tfloat focusRange = uDoFParams.z > 0.0 ? uDoFParams.z : 0.3;\n\tfloat blurFactor = smoothstep(focusRange, 1.0, abs(distFromCenter - focusDist));\n\t\n\tfloat maxBlur = uDoFParams.x > 0.0 ? uDoFParams.x : 0.008;\n\tfloat radius = blurFactor * maxBlur;\n\t\n\tif (radius < 0.0005) {\n\t\tfragColor = TDOutputSwizzle(baseColor);\n\t\treturn;\n\t}\n\t\n\tvec4 accum = vec4(0.0);\n\tfloat totalWeight = 0.0;\n\t\n\tvec2 offsets[8] = vec2[](\n\t\tvec2(1.0, 0.0), vec2(0.707, 0.707), vec2(0.0, 1.0), vec2(-0.707, 0.707),\n\t\tvec2(-1.0, 0.0), vec2(-0.707, -0.707), vec2(0.0, -1.0), vec2(0.707, -0.707)\n\t);\n\t\n\tfor (int i = 0; i < 8; i++) {\n\t\tvec2 sampleUV = clamp(uv + offsets[i] * radius, 0.0, 1.0);\n\t\tvec4 smp = texture(sTD2DInputs[0], sampleUV);\n\t\tfloat luma = dot(smp.rgb, vec3(0.299, 0.587, 0.114));\n\t\tfloat weight = 1.0 + luma * 2.0;\n\t\taccum += smp * weight;\n\t\ttotalWeight += weight;\n\t}\n\t\n\tvec4 bokehResult = accum / totalWeight;\n\tvec4 finalColor = mix(baseColor, bokehResult, clamp(blurFactor * 1.2, 0.0, 1.0));\n\tfragColor = TDOutputSwizzle(finalColor);\n}\n"
  dat_content_format: text
