- name: anamorphic_streak_glsl_pixel
  type: textDAT
  parameters:
    language: glsl
    extension: frag
  flags:
  - viewer
  position: [1923, -772]
  dock: anamorphic_streak_glsl
  dat_content: "// Anamorphic Bloom Streak Pixel Shader\nout vec4 fragColor;\nvoid main()\n{\n\tvec2 uv = vUV.st;\n\tvec4 sum = vec4(0.0);\n\tfloat weights[9] = float[](0.05, 0.09, 0.12, 0.15, 0.18, 0.15, 0.12, 0.09, 0.05);\n\tfloat dx = 0.003;\n\t\n\tfor (int i = -4; i <= 4; i++) {\n\t\tvec2 sampleUV = clamp(uv + vec2(float(i) * dx, 0.0), 0.0, 1.0);\n\t\tsum += texture(sTD2DInputs[0], sampleUV) * weights[i + 4];\n\t}\n\tfragColor = TDOutputSwizzle(sum * 1.3);\n}\n"
  dat_content_format: text
