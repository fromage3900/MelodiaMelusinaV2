#!/usr/bin/env bash
set -euo pipefail

# Post-checkout hook: LFS pull hint for collaborators
# After switching branches, remind collaborators to pull LFS assets they need.

echo "==> [post-checkout] Checking LFS state..."

# Only run on branch switches (not file checkout)
if [ "$3" = "1" ]; then
  # Check if LFS is installed
  if command -v git-lfs >/dev/null 2>&1; then
    # Count LFS files that are pointers (not real content)
    LFS_POINTERS=$(git lfs ls-files 2>/dev/null | wc -l)
    if [ "$LFS_POINTERS" -gt 0 ]; then
      echo "==> [post-checkout] This repo tracks $LFS_POINTERS LFS files."
      echo "==> [post-checkout] If assets appear missing/pink in Unreal, run:"
      echo "    git lfs pull"
      echo ""
      echo "    For targeted pulls (lightweight collaborators):"
      echo "    git lfs pull --include=\"Content/EnvSandbox/Levels/*.umap\""
      echo "    git lfs pull --include=\"Content/EnvSandbox/Materials/*.uasset\""
    fi
  else
    echo "WARNING: [post-checkout] Git LFS not installed."
    echo "Install: git lfs install"
  fi
fi

echo "==> [post-checkout] Done."
exit 0
