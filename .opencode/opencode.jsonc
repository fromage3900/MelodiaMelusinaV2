{
  "$schema": "https://opencode.ai/config.json",

  // CANONICAL RIDER ENGINEERING COCKPIT: Ponytail UE5.8 is the project UE-agent
  // discipline layer for OpenCode-in-Rider. The checkout is machine-local at
  // Tools/vendor/ponytail-ue58 (ignored by Tools/*); verify/rehydrate it with
  // deploy/verify_rider_cockpit.ps1 [-InstallPonytail]. It injects the UE-aware
  // "lazy senior" ruleset and /ponytail, /ponytail-review, /ponytail-audit commands.
  // AGENTS.md / CURRENT_STATE.md / subsystem contracts still outrank vendor rules.
  "plugin": ["./Tools/vendor/ponytail-ue58/.opencode/plugins/ponytail.mjs"],

  // Default model (set 2026-08-14). Qwen3 Coder Next on bedrock-mantle: coder-tuned,
  // long context, verified working, and ~$0.74/month at this project's measured
  // 745K tokens/month. It is the default because it is the right tool for UE C++ and
  // Blueprint work, not because it is cheap -- the whole Mantle spread is $0.20-$2.16
  // a month here, so capability is the only sensible axis to choose on.
  //
  // Requires AWS_PROFILE=bedrock (SigV4) or AWS_BEARER_TOKEN_BEDROCK before launch.
  // Override per session with `opencode --model <provider>/<id>`.
  "model": "bedrock-mantle/qwen.qwen3-coder-next",

  "permission": {
    "edit": "ask",
    "bash": "allow"
  },

  // ---------------------------------------------------------------------
  // Amazon Bedrock via bedrock-mantle (rewritten 2026-08-14 -- VERIFIED WORKING)
  //
  // Why: the OpenRouter key here is free tier and its paid-model daily quota
  // exhausts mid-day (402s), so the Rider lane dies partway through a session.
  // Bedrock bills per token against the AWS account -- no daily cliff.
  //
  // THREE THINGS THE PREVIOUS VERSION OF THIS BLOCK GOT WRONG:
  //
  // 1. The endpoint. bedrock-mantle is a plain OpenAI-compatible HTTPS API at
  //    https://bedrock-mantle.{region}.api.aws/v1  -- note `.api.aws`, NOT
  //    `.amazonaws.com`. Pointing an OpenAI client at the amazonaws.com host is
  //    why Cline failed on 2026-08-14.
  // 2. The IAM actions. bedrock-mantle is a SEPARATE service from bedrock. It
  //    needs `bedrock-mantle:CreateInference` on
  //    arn:aws:bedrock-mantle:REGION:ACCT:project/default. A policy granting only
  //    `bedrock:*` gets a 401 naming the missing action.
  // 3. The model ids. Mantle drops the `us.` prefix and the `-v1:0` suffix:
  //    `qwen.qwen3-coder-next`, not `us.qwen...-v1:0`.
  //
  // Plain bedrock-runtime Converse still returns "Operation not allowed" for
  // every model on this account including Amazon's own Nova -- unexplained, and
  // no longer relevant since Mantle serves 55 models.
  //
  // Auth: a Bedrock API key as a bearer token, OR the AWS credential chain.
  // No key belongs in this file. Pick the identity before launching Rider:
  //
  //     $env:AWS_PROFILE = "bedrock"                 # PowerShell, SigV4
  //     $env:AWS_BEARER_TOKEN_BEDROCK = "<key>"      # or a Bedrock API key
  //
  // Verified live 2026-08-14: qwen3-coder-next, qwen3-coder-480b, deepseek.v3.2,
  // devstral-2 and both kimi models all returned completions.
  // Keep in step with the "cpp" and "deep" classes in Tools/model_router.py.
  "provider": {
    "bedrock-mantle": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://bedrock-mantle.us-east-1.api.aws/v1"
      },
      "models": {
        "qwen.qwen3-coder-next":              { "name": "Qwen3 Coder Next -- long C++" },
        "qwen.qwen3-coder-480b-a35b-instruct":{ "name": "Qwen3 Coder 480B -- heavy" },
        "deepseek.v3.2":                      { "name": "DeepSeek v3.2 -- reasoning coder" },
        "mistral.devstral-2-123b":            { "name": "Devstral 2 -- code specialist" },
        "moonshotai.kimi-k2-thinking":        { "name": "Kimi K2 Thinking -- long reasoning" },
        "moonshotai.kimi-k2.5":               { "name": "Kimi K2.5" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen2.5:14b": { "name": "Qwen2.5 14B -- heavy code/reasoning" },
        "qwen2.5-coder:7b": { "name": "Qwen2.5 Coder 7B -- fast code" },
        "deepseek-r1:14b": { "name": "DeepSeek R1 14B -- reasoning" },
        "hermes3:latest": { "name": "Hermes 3 -- general" }
      }
    }
  },

  "agent": {
    "build": {
      "mode": "primary",
      "description": "Canonical Melodia Rider/Ponytail engineering executor. Stay on the assigned branch; no switch/merge/rebase/reset/clean/commit unless explicitly authorized. Use existing owners, Qodana, UBT, RiderLink and UE evidence.",
      "permission": {
        "edit": "ask",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "description": "Readonly Rider/Ponytail planning and review. Inspect reflected/Blueprint ownership first; use Jev for bounded judgment when needed; do not mutate Git branch or Unreal state.",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  },

  "mcp": {
    // Canonical editor bridge: exactly one Unreal Editor / one Monolith writer on 9316.
    "monolith": {
      "type": "remote",
      "url": "http://127.0.0.1:9316/mcp",
      "enabled": true
    },
    // Blender MCP remains a DCC companion surface; it does not gain Unreal/editor authority.
    "blender-mcp": {
      "type": "remote",
      "url": "http://127.0.0.1:9317",
      "enabled": true
    },

    // Locals ported from root .opencode.json (no secrets).
    "ollama-mcp": {
      "type": "local",
      "command": [
        "node",
        "C:\\Users\\froma\\AppData\\Roaming\\npm\\node_modules\\ollama-mcp\\dist\\index.js"
      ],
      "environment": {
        "OLLAMA_HOST": "http://127.0.0.1:11434"
      },
      "enabled": true
    },
    "hermes": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-hermes"],
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": [
        "node",
        "C:\\Users\\froma\\AppData\\Roaming\\npm\\node_modules\\@modelcontextprotocol\\server-filesystem\\dist\\index.js",
        "C:\\EnvironmentPortfolio\\BS_GodFile"
      ],
      "enabled": true
    },
    "git-mcp": {
      "type": "local",
      "command": [
        "python",
        "C:\\EnvironmentPortfolio\\BS_GodFile\\deploy\\mcp_git.py"
      ],
      "enabled": true
    }
  }
}
